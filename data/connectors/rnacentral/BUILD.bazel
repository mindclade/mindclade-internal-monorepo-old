load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "rnacentral",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "go.mindclade.dev/data/connectors/rnacentral",
    deps = ["//data/connectors"],
