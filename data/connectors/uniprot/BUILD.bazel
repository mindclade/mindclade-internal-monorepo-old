load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "uniprot",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "go.mindclade.dev/data/connectors/uniprot",
    deps = ["//data/connectors"],
)

go_test(
    name = "uniprot_test",
    srcs = ["uniprot_test.go"],
    embed = [":uniprot"],
    deps = ["//data/connectors"],
)
