load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "gcs",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "go.mindclade.dev/data/connectors/gcs",
    deps = ["//data/connectors"],
)

go_test(
    name = "gcs_test",
    srcs = ["gcs_test.go"],
    embed = [":gcs"],
    deps = ["//data/connectors"],
)
