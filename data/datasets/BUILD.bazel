load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "examples",
    srcs = glob([
        "manifests/*.json",
        "mixtures/*.toml",
    ]),
    visibility = ["//data/datasets/tests:__pkg__"],
)

py_library(
    name = "datasets",
    srcs = glob(["*.py"]),
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//data",
        "//data/contracts",
    ],
)
