{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["activation", "image", "replicaCount", "server", "auth", "artifacts", "serviceAccount", "resources", "autoscaling", "podDisruptionBudget", "migration", "networkPolicy", "monitoring", "nodeSelector", "tolerations", "topologySpreadConstraints"],
  "properties": {
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "releaseEvidenceDigest"],
      "properties": {
        "enabled": {"type": "boolean"},
        "releaseEvidenceDigest": {"type": "string", "pattern": "^(blocked|sha256:[0-9a-f]{64})$"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]{2,255}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 2, "maximum": 32},
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "workers", "allowedHosts", "corsAllowedOrigins", "xFrameOptions", "secretsCacheTTLSeconds", "secretsCacheMaxSize", "terminationGracePeriodSeconds", "gatewayBudgetRefreshIntervalSeconds"],
      "properties": {
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "workers": {"type": "integer", "minimum": 1, "maximum": 16},
        "allowedHosts": {"type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.*:-]{1,253}$"}},
        "corsAllowedOrigins": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^\\s,]+$"}},
        "xFrameOptions": {"enum": ["DENY", "SAMEORIGIN"]},
        "secretsCacheTTLSeconds": {"type": "integer", "minimum": 10, "maximum": 300},
        "secretsCacheMaxSize": {"type": "integer", "minimum": 1, "maximum": 10000},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30, "maximum": 300},
        "gatewayBudgetRefreshIntervalSeconds": {"type": "integer", "minimum": 10, "maximum": 600}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "authConfigKey", "backendStoreURIKey", "flaskSecretKey", "gatewayBudgetRedisURIKey", "traceArchivalConfigKey"],
      "properties": {
        "existingSecret": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,253}$"},
        "authConfigKey": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,253}$"},
        "backendStoreURIKey": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,253}$"},
        "flaskSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,253}$"},
        "gatewayBudgetRedisURIKey": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,253}$"},
        "traceArchivalConfigKey": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,253}$"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "modelVersionSourceValidationRegex"],
      "properties": {
        "destination": {"type": "string", "maxLength": 1024},
        "modelVersionSourceValidationRegex": {"type": "string", "maxLength": 1024}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "gcpServiceAccount"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
        "gcpServiceAccount": {"type": "string", "maxLength": 256}
      }
    },
    "resources": {"type": "object"},
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minimumReplicas", "maximumReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minimumReplicas": {"type": "integer", "minimum": 2, "maximum": 32},
        "maximumReplicas": {"type": "integer", "minimum": 2, "maximum": 64},
        "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxUnavailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxUnavailable": {"type": "integer", "minimum": 1, "maximum": 31}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "activeDeadlineSeconds", "backoffLimit"],
      "properties": {
        "enabled": {"type": "boolean"},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingressNamespaceNames", "database", "redis", "httpsCIDRs", "workloadIdentityMetadata"],
      "properties": {
        "ingressNamespaceNames": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"}},
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port", "cidrs"],
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "cidrs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}}
          }
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port", "cidrs"],
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "cidrs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}}
          }
        },
        "httpsCIDRs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}},
        "workloadIdentityMetadata": {"type": "boolean"}
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "collectorNamespaceNames", "interval", "timeout"],
      "properties": {
        "enabled": {"type": "boolean"},
        "collectorNamespaceNames": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"}},
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"},
        "timeout": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"}
      }
    },
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array", "maxItems": 32},
    "topologySpreadConstraints": {"type": "array", "minItems": 1, "maxItems": 16}
  },
  "allOf": [
    {
      "if": {"properties": {"activation": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "activation": {"properties": {"releaseEvidenceDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}}},
          "migration": {"properties": {"enabled": {"const": true}}},
          "server": {"properties": {"allowedHosts": {"minItems": 1}}},
          "artifacts": {
            "properties": {
              "destination": {"pattern": "^gs://[a-z0-9][a-z0-9._-]{1,221}[a-z0-9]/[^\\s]*$"},
              "modelVersionSourceValidationRegex": {"pattern": "^\\^gs://"}
            }
          },
          "serviceAccount": {"properties": {"gcpServiceAccount": {"pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"}}},
          "networkPolicy": {
            "properties": {
              "ingressNamespaceNames": {"minItems": 1},
              "database": {"properties": {"cidrs": {"minItems": 1}}},
              "redis": {"properties": {"cidrs": {"minItems": 1}}},
              "httpsCIDRs": {"minItems": 1}
            }
          },
          "monitoring": {
            "properties": {
              "enabled": {"const": true},
              "collectorNamespaceNames": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
