package(default_visibility = ["//visibility:private"])

filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "BUILD.bazel",
        ],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "files",
    srcs = [":manifests"],
    visibility = ["//visibility:public"],
)
