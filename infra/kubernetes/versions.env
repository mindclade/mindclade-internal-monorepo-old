#
# Sourceable, non-secret compatibility tuple for Kubernetes manifests. This is
# not an installer and contains no cluster endpoint or credential. Changes must
# remain aligned with infra/terraform/modules/gke and the pinned upstream-content
# lock under infra/gitops/argocd/bootstrap.

MINDCLADE_FOUNDATION_CONTRACT_VERSION=1
MINDCLADE_GKE_RELEASE_CHANNEL=REGULAR
MINDCLADE_KUBERNETES_VERSION=1.36.2-gke.2064000
MINDCLADE_KUBERNETES_MINOR=1.36
MINDCLADE_POD_SECURITY_STANDARD=restricted
MINDCLADE_POD_SECURITY_VERSION=v1.36
MINDCLADE_KUSTOMIZE_API_VERSION=kustomize.config.k8s.io/v1beta1
MINDCLADE_GATEWAY_API_VERSION=gateway.networking.k8s.io/v1
MINDCLADE_CERT_MANAGER_VERSION=v1.19.1

# Kueue and JobSet versions are intentionally absent. Their manifests and CRDs
# remain activation-blocked until a reviewed compatibility tuple is selected.
