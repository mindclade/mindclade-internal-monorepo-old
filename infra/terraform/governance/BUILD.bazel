load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "interface_governance",
    srcs = ["interface_governance.py"],
    visibility = [
        "//infra/terraform/environments/dns_hub:__pkg__",
        "//infra/terraform/modules:__pkg__",
    ],
)

filegroup(
    name = "governance_data",
    srcs = glob(
        [
            "*.json",
            "*.toml",
            "baselines/*.json",
            "migrations/*.toml",
        ],
    ),
    visibility = [
        "//infra/terraform/environments/dns_hub:__pkg__",
        "//infra/terraform/modules:__pkg__",
    ],
)
