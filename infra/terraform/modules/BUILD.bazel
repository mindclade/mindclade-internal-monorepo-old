load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

# Each child module is a Bazel package, so a parent glob cannot cross those boundaries.
# Depend on their existing exported filegroups to make the governance test's checkout view
# complete and hermetic rather than reaching into BUILD_WORKSPACE_DIRECTORY.
