{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.com/contracts/observability/availability-profiles-1.0.0.schema.json",
  "title": "Mindclade availability profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvalStatus", "profiles", "activationPolicy"],
  "properties": {
    "schemaVersion": {"const": "mindclade.dev/availability-profiles/v1"},
    "approvalStatus": {"const": "proposed"},
    "profiles": {"type": "array", "minItems": 4, "maxItems": 16, "items": {"$ref": "#/$defs/profile"}},
    "activationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabledByDefault", "requiresEnvironmentApproval"],
      "properties": {
        "enabledByDefault": {"const": false},
        "requiresEnvironmentApproval": {"const": true}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "serviceClasses", "sli", "objective", "window", "minimumEvents", "fastBurn", "slowBurn"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "serviceClasses": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["control-plane", "data-pipeline", "frontend", "model-serving", "release", "training"]}},
        "sli": {"enum": ["availability", "completion", "freshness"]},
        "objective": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "window": {"enum": ["7d", "28d", "30d"]},
        "minimumEvents": {"type": "integer", "minimum": 1},
        "fastBurn": {"type": "number", "exclusiveMinimum": 1},
        "slowBurn": {"type": "number", "exclusiveMinimum": 1}
      }
    }
  }
}
