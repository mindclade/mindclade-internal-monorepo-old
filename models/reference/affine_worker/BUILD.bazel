load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build/bazel/rules:release.bzl", "mindclade_model_bundle")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "make_bundle_lib",
    srcs = ["make_bundle.py"],
    imports = ["../../.."],
    visibility = ["//services/workers/model_worker/tests:__pkg__"],
    deps = ["//tools/release:build_model_bundle_lib"],
)

py_binary(
    name = "make_bundle",
    srcs = ["make_bundle.py"],
    deps = ["//tools/release:build_model_bundle_lib"],
)

genrule(
    name = "bundle",
    outs = [
        "bundle/config.json",
        "bundle/manifest.json",
        "bundle/model.safetensors",
    ],
    cmd = "$(execpath :make_bundle) --out $(RULEDIR)/bundle >/dev/null",
    tools = [":make_bundle"],
)

genrule(
    name = "annotations",
    srcs = ["bundle/manifest.json"],
    outs = ["annotations.txt"],
    cmd = "$(execpath //tools/release:emit_annotations) " +
          "--manifest $(location bundle/manifest.json) --out $@",
    tools = ["//tools/release:emit_annotations"],
)

mindclade_model_bundle(
    name = "reference_affine",
    annotations = ":annotations",
    visibility = ["//visibility:public"],
    weights = {
        ":bundle/config.json": "config.json",
        ":bundle/manifest.json": "manifest.json",
        ":bundle/model.safetensors": "model.safetensors",
    },
)
