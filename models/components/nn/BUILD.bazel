load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "nn",
    srcs = [
        "__init__.py",
        "activations.py",
        "feed_forward.py",
        "residual.py",
    ],
    imports = ["../../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//kernels/ops/fused",
        "@pypi//torch",
    ],
)

filegroup(
    name = "scaffold_files",
    srcs = [
        "dropout.py",
        "parametrization.py",
        "stochastic_depth.py",
    ],
    visibility = ["//visibility:public"],
)
