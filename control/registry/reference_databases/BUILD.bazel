load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "reference_databases",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "go.mindclade.dev/control/registry/reference_databases",
    visibility = [
        "//control:__subpackages__",
        "//services:__subpackages__",
    ],
    deps = [
        "//control/artifacts",
        "//libs/go/faults",
        "//libs/go/identifiers",
    ],
)

go_test(
    name = "reference_databases_test",
    srcs = glob(["*_test.go"]),
    embed = [":reference_databases"],
    deps = [
        "//control/artifacts",
        "//libs/go/identifiers",
    ],
)
