load("@rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "scaffold_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

go_library(
    name = "audit",
    srcs = [
        "doc.go",
        "model.go",
        "repository.go",
        "service.go",
    ],
    importpath = "go.mindclade.dev/control/audit",
)
