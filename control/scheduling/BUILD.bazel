load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "scaffold_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

go_library(
    name = "scheduling",
    srcs = [
        "admission.go",
        "capacity.go",
        "doc.go",
        "placement.go",
        "pool.go",
        "preemption.go",
        "priority.go",
        "repository.go",
        "reservation.go",
        "service.go",
        "topology.go",
        "validation.go",
    ],
    importpath = "go.mindclade.dev/control/scheduling",
    visibility = [
        "//control:__subpackages__",
        "//services:__subpackages__",
    ],
    deps = [
        "//control/orchestration",
        "//libs/go/clock",
        "//libs/go/coordination/workqueue",
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/resourceversion",
    ],
)

go_test(
    name = "scheduling_test",
    srcs = glob(["*_test.go"]),
    embed = [":scheduling"],
    deps = [
        "//control/orchestration",
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/identifiers",
    ],
)
