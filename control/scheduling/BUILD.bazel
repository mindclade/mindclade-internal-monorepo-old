load("@rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "scaffold_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

go_library(
    name = "scheduling",
    srcs = [
        "admission.go",
        "capacity.go",
        "doc.go",
        "placement.go",
        "pool.go",
        "preemption.go",
        "priority.go",
        "repository.go",
        "reservation.go",
        "service.go",
        "topology.go",
    ],
    importpath = "go.mindclade.dev/control/scheduling",
)
