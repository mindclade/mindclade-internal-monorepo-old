load("@rules_go//go:def.bzl", "go_library", "go_test")
package(default_visibility = ["//visibility:private"])
go_library(
    name = "runtime_authority",
    srcs = glob(["*.go"], exclude=["*_test.go"]),
    importpath = "mindclade.internal/control/runtime_authority",
    visibility = ["//control:__subpackages__", "//services:__subpackages__", "//examples:__subpackages__"],
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/signing",
    ],
)
go_test(name="runtime_authority_test", srcs=glob(["*_test.go"]), embed=[":runtime_authority"])
