load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "admission",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "go.mindclade.dev/control/admission",
    visibility = [
        "//control:__subpackages__",
        "//services:__subpackages__",
    ],
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/idempotency",
        "//libs/go/identifiers",
        "//libs/go/resourceversion",
    ],
)

go_test(
    name = "admission_test",
    srcs = ["admission_test.go"],
    embed = [":admission"],
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/idempotency",
        "//libs/go/identifiers",
        "//libs/go/resourceversion",
    ],
)
