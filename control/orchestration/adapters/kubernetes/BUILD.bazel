load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "scaffold_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

go_library(
    name = "kubernetes",
    srcs = [
        "jobset.go",
        "kueue.go",
        "launcher.go",
        "resources.go",
    ],
    importpath = "go.mindclade.dev/control/orchestration/adapters/kubernetes",
    visibility = [
        "//control:__subpackages__",
        "//services:__subpackages__",
    ],
    deps = [
        "//control/orchestration",
        "//control/runtime_authority",
        "//control/scheduling",
        "//control/scheduling/adapters/jobset",
        "//control/scheduling/adapters/kueue",
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/kubernetes",
        "//libs/go/kubernetes/metadata",
        "//libs/go/kubernetes/patch",
        "@io_k8s_api//batch/v1:batch",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/resource",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_sigs_controller_runtime//pkg/client",
    ],
)

go_test(
    name = "kubernetes_test",
    srcs = glob(["*_test.go"]),
    embed = [":kubernetes"],
    deps = [
        "//control/orchestration",
        "//control/orchestration/launchertest",
        "//control/runtime_authority",
        "//control/scheduling",
        "//control/scheduling/adapters/kueue",
        "//libs/go/faults",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
    ],
)
