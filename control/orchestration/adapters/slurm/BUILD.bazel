load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "scaffold_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

go_library(
    name = "slurm",
    srcs = ["launcher.go"],
    importpath = "go.mindclade.dev/control/orchestration/adapters/slurm",
    visibility = [
        "//control:__subpackages__",
        "//services:__subpackages__",
    ],
    deps = [
        "//control/orchestration",
        "//control/runtime_authority",
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/identifiers",
    ],
)

go_test(
    name = "slurm_test",
    srcs = glob(["*_test.go"]),
    embed = [":slurm"],
    deps = [
        "//control/orchestration",
        "//control/orchestration/launchertest",
        "//control/runtime_authority",
        "//libs/go/faults",
    ],
)
