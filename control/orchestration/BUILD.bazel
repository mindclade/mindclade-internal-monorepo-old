load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "orchestration",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "go.mindclade.dev/control/orchestration",
    visibility = [
        "//control:__subpackages__",
        "//services:__subpackages__",
    ],
    deps = [
        "//control/artifacts",
        "//control/runtime_authority",
        "//libs/go/clock",
        "//libs/go/coordination",
        "//libs/go/coordination/workqueue",
        "//libs/go/faults",
        "//libs/go/idempotency",
        "//libs/go/identifiers",
        "//libs/go/resourceversion",
        "//libs/go/storage/lease",
    ],
)

go_test(
    name = "orchestration_test",
    srcs = glob(["*_test.go"]),
    embed = [":orchestration"],
    deps = [
        "//control/artifacts",
        "//control/runtime_authority",
        "//libs/go/faults",
        "//libs/go/idempotency",
        "//libs/go/identifiers",
    ],
)
