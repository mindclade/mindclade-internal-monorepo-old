load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "artifacts",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "go.mindclade.dev/control/artifacts",
    visibility = [
        "//control:__subpackages__",
        "//services:__subpackages__",
        "//tests:__subpackages__",
    ],
    deps = [
        "//libs/go/faults",
        "//libs/go/identifiers",
    ],
)

go_test(
    name = "artifacts_test",
    srcs = glob(["*_test.go"]),
    embed = [":artifacts"],
)
