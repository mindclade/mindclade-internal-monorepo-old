load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "checkpointing",
    srcs = [
        "__init__.py",
        "adamw.py",
        "atomic_commit.py",
        "dcp.py",
        "manifest.py",
        "resume.py",
        "serialization.py",
        "trainer.py",
    ],
    imports = ["../.."],
    deps = [
        "//libs/python/errors",
        "//libs/python/identifiers",
        "//libs/python/serialization",
        "//training/contracts",
        "//training/core:trainer",
        "@pypi//numpy",
        "@pypi//safetensors",
        "@pypi//torch",
    ],
)

# The remaining reserved paths retain their explicit scaffold status. Resharding, retention,
# and remote staging are not part of either implemented checkpoint contract.
filegroup(
    name = "remaining_scaffold_files",
    srcs = glob(
        ["*.py"],
        exclude = [
            "__init__.py",
            "adamw.py",
            "atomic_commit.py",
            "dcp.py",
            "manifest.py",
            "resume.py",
            "serialization.py",
            "trainer.py",
        ],
    ),
)
