load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "ddp",
    srcs = [
        "__init__.py",
        "ddp.py",
    ],
    imports = ["../../.."],
    deps = [
        "//libs/python/errors",
        "//training/distributed:runtime",
        "@pypi//torch",
    ],
)

filegroup(
    name = "remaining_scaffold_files",
    srcs = glob(
        ["*.py"],
        exclude = [
            "__init__.py",
            "ddp.py",
        ],
    ),
)
