load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "contracts",
    srcs = [
        "__init__.py",
        "batch.py",
        "result.py",
        "state.py",
        "task.py",
    ],
    imports = ["../.."],
    deps = [
        "//libs/python/errors",
        "@pypi//torch",
    ],
)

filegroup(
    name = "remaining_scaffold_files",
    srcs = glob(
        ["*.py"],
        exclude = [
            "__init__.py",
            "batch.py",
            "result.py",
            "state.py",
            "task.py",
        ],
    ),
)
