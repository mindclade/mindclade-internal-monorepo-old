#
# These were plain py_test targets over pytest modules. A py_test runs its src as a script, so
# the bare `test_*` functions never executed and every target passed having verified nothing —
# while importing a pytest that was not a declared dependency. pytest_test runs them for real.

load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

[
    pytest_test(
        name = name,
        srcs = [name + ".py"],
        imports = ["../../.."],
        deps = ["//serving/model_worker"],
    )
    for name in [
        "test_advanced_runtime",
        "test_batching",
        "test_model_loader",
        "test_training_parity",
        "test_worker",
    ]
]
