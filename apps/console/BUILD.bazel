load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:private"])

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "base_tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_config(
    name = "bazel_tsconfig",
    src = "tsconfig.bazel.json",
    deps = [":base_tsconfig"],
)

filegroup(
    name = "assets",
    srcs = glob(["src/**/*.css"]),
    visibility = ["//visibility:public"],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":typescript",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "typescript",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
    ]),
    declaration = True,
    out_dir = "bazel-dist",
    root_dir = "src",
    source_map = True,
    transpiler = "tsc",
    tsconfig = ":bazel_tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@mindclade/libs-ts-api-client",
        ":node_modules/@mindclade/libs-ts-charts",
        ":node_modules/@mindclade/libs-ts-design-system",
        ":node_modules/@mindclade/libs-ts-molecular-viewer",
        ":node_modules/@mindclade/libs-ts-telemetry",
        ":node_modules/@mindclade/sdk-typescript",
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/next",
        ":node_modules/react",
        ":node_modules/react-dom",
        "//libs/ts/api_client:typescript",
        "//libs/ts/charts:typescript",
        "//libs/ts/design_system:typescript",
        "//libs/ts/molecular_viewer:typescript",
        "//libs/ts/telemetry:typescript",
        "//sdk/typescript",
    ],
)
