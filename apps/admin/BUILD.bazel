load("@aspect_rules_js//contrib/nextjs:defs.bzl", "nextjs_standalone_server")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_pkg//pkg:mappings.bzl", "REMOVE_BASE_DIRECTORY", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/build/bazel/rules:nextjs.bzl", "mindclade_nextjs_standalone_build")
load("//tools/build/bazel/rules:typescript.bzl", "typescript_test")

package(default_visibility = ["//visibility:private"])

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "base_tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_config(
    name = "bazel_tsconfig",
    src = "tsconfig.bazel.json",
    deps = [":base_tsconfig"],
)

filegroup(
    name = "assets",
    srcs = glob(["src/**/*.css"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "next_sources",
    srcs = glob(
        [
            "src/**",
            "public/**",
        ],
        allow_empty = True,
    ) + [
        "package.json",
        "tsconfig.json",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":typescript",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "typescript",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
    ]),
    declaration = True,
    out_dir = "bazel-dist",
    root_dir = "src",
    source_map = True,
    transpiler = "tsc",
    tsconfig = ":bazel_tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@mindclade/libs-ts-api-client",
        ":node_modules/@mindclade/libs-ts-auth",
        ":node_modules/@mindclade/libs-ts-browser-security",
        ":node_modules/@mindclade/libs-ts-design-system",
        ":node_modules/@mindclade/libs-ts-telemetry",
        ":node_modules/@mindclade/sdk-typescript",
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/next",
        ":node_modules/react",
        ":node_modules/react-dom",
        "//libs/ts/api_client:typescript",
        "//libs/ts/auth:typescript",
        "//libs/ts/browser_security:typescript",
        "//libs/ts/design_system:typescript",
        "//libs/ts/telemetry:typescript",
        "//sdk/typescript",
    ],
)

typescript_test(
    name = "unit_tests",
    srcs = glob([
        "tests/**/*.ts",
        "tests/**/*.tsx",
    ]),
    data = [
        "next.config.ts",
        ":next_sources",
        ":node_modules",
        "//:tsconfig_base_bin",
        "//libs/ts/auth:pkg",
        "//libs/ts/browser_security:pkg",
    ],
    entry_point = "tests/run-tests.ts",
)

mindclade_nextjs_standalone_build(
    name = "next_bundle",
    srcs = [":next_sources"],
    config = "next.config.ts",
    data = [
        ":node_modules",
        "//:tsconfig_base_bin",
        "//libs/ts/api_client:pkg",
        "//libs/ts/auth:pkg",
        "//libs/ts/browser_security:pkg",
        "//libs/ts/design_system:pkg",
        "//libs/ts/telemetry:pkg",
        "//sdk/typescript:pkg",
    ],
    env = {
        "NEXT_TELEMETRY_DISABLED": "1",
        "NODE_ENV": "production",
    },
    next_js_binary = "//:next_js_binary",
    visibility = ["//visibility:public"],
)

nextjs_standalone_server(
    name = "server",
    app = ":next_bundle",
    data = [
        ":node_modules/next",
        ":node_modules/react",
        ":node_modules/react-dom",
    ],
    # Next 16 traces this workspace build to a root-level standalone server.
    # Keep static/public beside that entry point rather than under apps/admin.
    pkg = ".",
    visibility = ["//visibility:public"],
)

# The upstream server target carries these modules as Bazel runfiles, but the
# raw standalone tree does not. Materialize that same pinned runtime graph in
# the conventional node_modules location so the release tar runs after plain
# extraction without Bazel's runfiles launcher.
copy_to_directory(
    name = "_release_tree",
    srcs = [
        ":_server.standalone",
        ":node_modules/next",
        ":node_modules/react",
        ":node_modules/react-dom",
    ],
    out = "release_tree",
    allow_overwrites = True,
    replace_prefixes = {
        "node_modules": "server/standalone/node_modules",
        "node_modules/.aspect_rules_js/*/node_modules": "server/standalone/node_modules",
    },
    visibility = ["//visibility:private"],
)

pkg_files(
    name = "_release_files",
    srcs = [":_release_tree"],
    renames = {":_release_tree": REMOVE_BASE_DIRECTORY},
)

# Release jobs attach provenance, SBOM, and signatures to this deterministic
# archive. Those connected controls deliberately remain outside this source
# target; this target owns only the exact standalone server bytes.
pkg_tar(
    name = "release_archive",
    srcs = [":_release_files"],
    extension = "tar.gz",
    mode = "0555",
    portable_mtime = True,
    stamp = 0,
    visibility = ["//visibility:public"],
)
