{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "incremental": false,
    "noEmit": false,
    "outDir": "bazel-dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [".next", "bazel-dist", "node_modules", "tests"]
}
