load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "kernel_core",
    srcs = [
        "dispatch.py",
        "manifest.py",
        "registry.py",
    ],
    imports = [".."],
    deps = ["//kernels/api"],
)

py_library(
    name = "kernels",
    srcs = [
        "__init__.py",
        "defaults.py",
    ],
    imports = [".."],
    deps = [
        ":kernel_core",
        "//kernels/providers/pytorch",
        "//kernels/providers/tilelang",
    ],
)
