    imports = ["../../.."],
    deps = [
        ":runtime_manifest",
        "//kernels:kernel_core",
        "//kernels/api",
        "//kernels/providers/tilelang/attention",
        "//kernels/providers/tilelang/diffusion",
        "//kernels/providers/tilelang/fp8",
        "//kernels/providers/tilelang/fused",
        "//kernels/providers/tilelang/moe",
        "//kernels/tilelang/targets",
        "@pypi//torch",
    ],
)
