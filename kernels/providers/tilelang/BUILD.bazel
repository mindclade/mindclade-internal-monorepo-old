load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files(["accelerator-constraints.txt"])

py_library(
    name = "runtime_manifest",
    srcs = ["manifest.py"],
    imports = ["../../.."],
)

