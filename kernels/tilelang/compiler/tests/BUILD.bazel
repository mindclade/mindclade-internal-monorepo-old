load("//tools/build:pytest.bzl", "pytest_test")

[
    pytest_test(
        name = source.removesuffix(".py"),
        srcs = [source],
        imports = ["../../../.."],
        deps = [
            "//kernels/tilelang/compiler",
            "//kernels/tilelang/targets",
        ],
    )
    for source in [
        "test_codegen.py",
        "test_layouts.py",
    ]
]
