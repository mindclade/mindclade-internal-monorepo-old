{
  "name": "@mindclade/internal-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "generate": "pnpm --filter @mindclade/sdk-typescript generate",
    "generate:check": "pnpm --filter @mindclade/sdk-typescript generate:check",
    "test": "pnpm -r --if-present test",
    "test:accessibility": "playwright test --config tests/accessibility/playwright.config.ts",
    "lint": "python3 tools/analysis/check_typescript.py && pnpm --filter @mindclade/sdk-typescript build && pnpm --filter './libs/ts/*' build && pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @mindclade/sdk-typescript build && pnpm --filter './libs/ts/*' build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
