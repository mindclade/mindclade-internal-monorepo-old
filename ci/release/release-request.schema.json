{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.internal/ci/release-request.schema.json",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "release.mindclade.dev/v1beta2"},
    "kind": {"const": "ReleaseRequest"},
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "changeTicket": {"pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$", "type": "string"},
        "name": {"pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string"}
      },
      "required": ["name", "changeTicket"],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "rollback": {
          "additionalProperties": false,
          "properties": {
            "previousRelease": {
              "additionalProperties": false,
              "properties": {
                "id": {"pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string"},
                "subjectDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}
              },
              "required": ["id", "subjectDigest"],
              "type": "object"
            },
            "strategy": {"enum": ["bootstrap", "previous-release"], "type": "string"}
          },
          "required": ["strategy"],
          "allOf": [
            {
              "if": {"properties": {"strategy": {"const": "bootstrap"}}},
              "then": {"not": {"required": ["previousRelease"]}}
            },
            {
              "if": {"properties": {"strategy": {"const": "previous-release"}}},
              "then": {"required": ["previousRelease"]}
            }
          ],
          "type": "object"
        },
        "target": {
          "enum": ["control-plane-registry", "go-vanity", "protobuf-contracts", "weights-fixture"],
          "type": "string"
        }
      },
      "required": ["target", "rollback"],
      "type": "object"
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "type": "object"
}
