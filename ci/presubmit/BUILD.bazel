load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "disk_preflight",
    srcs = ["disk_preflight.py"],
    imports = ["../.."],
)

py_library(
    name = "pipeline_lib",
    srcs = [
        "disk_preflight.py",
        "pipeline.py",
    ],
    data = [
        "targets.yaml",
        "//ci/bazel:full_graph_shards.toml",
    ],
    imports = ["../.."],
    deps = [
        "//ci/common:affected",
        "//ci/common:full_graph_shards",
    ],
)

py_binary(
    name = "pipeline",
    srcs = [
        "disk_preflight.py",
        "pipeline.py",
    ],
    data = [
        "targets.yaml",
        "//ci/bazel:full_graph_shards.toml",
    ],
    imports = ["../.."],
    main = "pipeline.py",
    deps = [
        "//ci/common:affected",
        "//ci/common:full_graph_shards",
    ],
)

py_library(
    name = "live_datastore_gate",
    srcs = ["live_datastore_gate.py"],
    data = ["//configs:live_datastore_suites"],
    imports = ["../.."],
)

pytest_test(
    name = "test_live_datastore_gate",
    srcs = [
        "live_datastore_gate.py",
        "test_live_datastore_gate.py",
    ],
    data = ["//configs:live_datastore_suites"],
    imports = ["../.."],
)

pytest_test(
    name = "test_disk_preflight",
    srcs = [
        "disk_preflight.py",
        "test_disk_preflight.py",
    ],
    imports = ["../.."],
)

pytest_test(
    name = "test_pipeline",
    srcs = [
        "disk_preflight.py",
        "pipeline.py",
        "test_pipeline.py",
    ],
    data = ["//ci/bazel:full_graph_shards.toml"],
    imports = ["../.."],
    deps = [
        "//ci/common:affected",
        "//ci/common:full_graph_shards",
    ],
)
