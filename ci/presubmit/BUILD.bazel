load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "pipeline_lib",
    srcs = ["pipeline.py"],
    imports = ["../.."],
    deps = ["//ci/common:affected"],
)

py_binary(
    name = "pipeline",
    srcs = ["pipeline.py"],
    data = ["targets.yaml"],
    imports = ["../.."],
    main = "pipeline.py",
    deps = ["//ci/common:affected"],
)

pytest_test(
    name = "test_pipeline",
    srcs = [
        "pipeline.py",
        "test_pipeline.py",
    ],
    imports = ["../.."],
    deps = ["//ci/common:affected"],
)
