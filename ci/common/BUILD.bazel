load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "affected_contract",
    srcs = ["affected_contract.py"],
    data = ["affected_global_inputs.json"],
    imports = ["../.."],
    visibility = [
        "//tools/analysis:__pkg__",
    ],
)

py_library(
    name = "affected",
    srcs = ["affected.py"],
    data = ["affected_global_inputs.json"],
    imports = ["../.."],
    visibility = [
        "//ci/nightly:__pkg__",
        "//ci/presubmit:__pkg__",
        "//tools/analysis:__pkg__",
    ],
    deps = [":affected_contract"],
)

py_library(
    name = "bazel_disk_cache_lib",
    srcs = ["bazel_disk_cache.py"],
    imports = ["../.."],
)

py_binary(
    name = "affected_cli",
    srcs = ["affected.py"],
    data = ["affected_global_inputs.json"],
    imports = ["../.."],
    main = "affected.py",
    visibility = ["//visibility:public"],
    deps = [":affected_contract"],
)

py_binary(
    name = "bazel_disk_cache",
    srcs = ["bazel_disk_cache.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "validate_affected_integration",
    srcs = ["validate_affected_integration.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [":affected"],
)

pytest_test(
    name = "affected_test",
    srcs = ["tests/test_affected.py"],
    env_inherit = ["MINDCLADE_GIT"],
    imports = ["../.."],
    deps = [":affected"],
)

pytest_test(
    name = "bazel_disk_cache_test",
    srcs = ["tests/test_bazel_disk_cache.py"],
    imports = ["../.."],
    deps = [":bazel_disk_cache_lib"],
)

pytest_test(
    name = "prepare_nix_runner_test",
    srcs = ["tests/test_prepare_nix_runner.py"],
    data = ["prepare_nix_runner.sh"],
)
