load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "affected",
    srcs = ["affected.py"],
    imports = ["../.."],
    visibility = [
        "//ci/nightly:__pkg__",
        "//ci/presubmit:__pkg__",
    ],
)

py_library(
    name = "bazel_remote_cache_lib",
    srcs = ["bazel_remote_cache.py"],
    # The contract travels with the library: load_contract() reads it by runfiles path, so a
    # target that depends on this without the JSON fails at run time rather than at analysis.
    data = ["bazel_remote_cache.json"],
    imports = ["../.."],
)

py_library(
    name = "bazel_disk_cache_lib",
    srcs = ["bazel_disk_cache.py"],
    imports = ["../.."],
    deps = [":bazel_remote_cache_lib"],
)

py_binary(
    name = "affected_cli",
    srcs = ["affected.py"],
    imports = ["../.."],
    main = "affected.py",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "bazel_disk_cache",
    srcs = ["bazel_disk_cache.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "validate_affected_integration",
    srcs = ["validate_affected_integration.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [":affected"],
)

pytest_test(
    name = "affected_test",
    srcs = ["tests/test_affected.py"],
    imports = ["../.."],
    deps = [":affected"],
)

pytest_test(
    name = "bazel_disk_cache_test",
    srcs = ["tests/test_bazel_disk_cache.py"],
    imports = ["../.."],
    deps = [":bazel_disk_cache_lib"],
)

pytest_test(
    name = "bazel_remote_cache_test",
    srcs = ["tests/test_bazel_remote_cache.py"],
    imports = ["../.."],
    deps = [":bazel_remote_cache_lib"],
)
