load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

# Two targets, because the two files answer different questions and a failure should name
# which. `//preprocessing/pipeline` already carries `//preprocessing/contracts`, so the plan
# types the tests construct come in with it. `imports` is the repository root, three levels up
# from this package, since both files import by dotted path.
pytest_test(
    name = "test_planner",
    srcs = ["test_planner.py"],
    imports = ["../../.."],
    deps = ["//preprocessing/pipeline"],
)

pytest_test(
    name = "test_resume",
    srcs = ["test_resume.py"],
    imports = ["../../.."],
    deps = ["//preprocessing/pipeline"],
)
