load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# The package root only carries __init__.py; each subpackage is its own Bazel package and
# declares its own library. Depending on the four that carry implementation makes
# //preprocessing:preprocessing the single label a consumer needs.
py_library(
    name = "preprocessing",
    srcs = glob(["*.py"]),
    imports = [".."],
    deps = [
        "//preprocessing/cache",
        "//preprocessing/contracts",
        "//preprocessing/pipeline",
        "//preprocessing/provenance",
    ],
)
