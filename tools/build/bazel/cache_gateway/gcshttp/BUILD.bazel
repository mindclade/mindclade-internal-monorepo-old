load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "gcshttp",
    srcs = ["store.go"],
    importpath = "go.mindclade.dev/tools/build/bazel/cache_gateway/gcshttp",
    visibility = ["//tools/build/bazel/cache_gateway/cmd:__pkg__"],
    deps = [
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/storage/blob",
    ],
)

go_test(
    name = "gcshttp_test",
    srcs = ["store_test.go"],
    embed = [":gcshttp"],
    deps = [
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/storage/blob",
    ],
)
