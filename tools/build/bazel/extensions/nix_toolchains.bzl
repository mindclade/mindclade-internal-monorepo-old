"""Bzlmod extension exposing the Nix-owned C/C++ toolchain bundle."""

_REQUIRED_TOOLS = [
    "ar",
    "cpp",
    "cxx_linker",
    "gcc",
    "ld",
    "nm",
    "objcopy",
    "objdump",
    "strip",
]

def _require_string(manifest, key):
    value = manifest.get(key)
    if type(value) != "string" or not value:
        fail("mindclade Nix C/C++ toolchain manifest requires a non-empty '{}' string".format(key))
    return value

def _quote(value):
    return repr(value)

def _nix_cc_repository_impl(repository_ctx):
    bundle_root = repository_ctx.os.environ.get("MINDCLADE_CC_TOOLCHAIN_ROOT")
    if not bundle_root:
        fail("""MINDCLADE_CC_TOOLCHAIN_ROOT is not set.

Run Bazel inside a repository Nix shell:

    nix develop .#ci --command tools/dev/bazelw <command>

The shell exports the immutable C/C++ bundle selected by flake.lock.""")

    manifest_path = repository_ctx.path(bundle_root + "/manifest.json")
    if not manifest_path.exists:
        fail("mindclade Nix C/C++ toolchain manifest is missing: {}".format(manifest_path))

    manifest = json.decode(repository_ctx.read(manifest_path))
    if type(manifest) != "dict" or manifest.get("schema") != 1:
        fail("mindclade Nix C/C++ toolchain manifest must be a schema-1 JSON object")

    system = _require_string(manifest, "system")
    target_cpu = _require_string(manifest, "target_cpu")
    target_triple = _require_string(manifest, "target_triple")
    compiler = _require_string(manifest, "compiler")
    if compiler != "clang":
        fail("mindclade Nix C/C++ toolchain compiler must be clang, got '{}'".format(compiler))

    constraints = manifest.get("constraints")
    if type(constraints) != "dict":
        fail("mindclade Nix C/C++ toolchain manifest requires a constraints object")
    constraint_os = _require_string(constraints, "os")
    constraint_cpu = _require_string(constraints, "cpu")

    tools = manifest.get("tools")
    if type(tools) != "dict":
        fail("mindclade Nix C/C++ toolchain manifest requires a tools object")
    generated_tools = {}
    for name in _REQUIRED_TOOLS:
        relative_path = _require_string(tools, name)
        if relative_path.startswith("/") or ".." in relative_path.split("/"):
            fail("mindclade Nix C/C++ toolchain tool '{}' has an unsafe path: {}".format(name, relative_path))
        source = repository_ctx.path(bundle_root + "/" + relative_path)
        if not source.exists:
            fail("mindclade Nix C/C++ toolchain required tool '{}' is missing: {}".format(name, source))
        generated_path = "bin/" + name
        repository_ctx.symlink(source, generated_path)
        generated_tools[name] = generated_path

    includes = manifest.get("builtin_include_directories")
    if type(includes) != "list" or not includes:
        fail("mindclade Nix C/C++ toolchain manifest requires builtin include directories")
    for include in includes:
        if type(include) != "string" or not repository_ctx.path(include).exists:
            fail("mindclade Nix C/C++ toolchain include directory is missing: {}".format(include))

    sdk_root = manifest.get("sdk_root")
    if constraint_os == "osx":
        if type(sdk_root) != "string" or not sdk_root:
            fail("mindclade Nix C/C++ toolchain requires an Apple SDK path on Darwin")
        if not repository_ctx.path(sdk_root).exists:
            fail("mindclade Nix C/C++ toolchain Apple SDK is missing: {}".format(sdk_root))

    compile_flags = manifest.get("compile_flags", [])
    link_flags = manifest.get("link_flags", [])
    if type(compile_flags) != "list" or type(link_flags) != "list":
        fail("mindclade Nix C/C++ toolchain compile_flags and link_flags must be arrays")
    for flag in compile_flags + link_flags:
        if type(flag) != "string" or not flag:
            fail("mindclade Nix C/C++ toolchain flags must be non-empty strings")

    link_library_directories = manifest.get("link_library_directories", [])
    if type(link_library_directories) != "list":
        fail("mindclade Nix C/C++ toolchain link_library_directories must be an array")
    for directory in link_library_directories:
        if type(directory) != "string" or not repository_ctx.path(directory).exists:
            fail("mindclade Nix C/C++ toolchain link library directory is missing: {}".format(directory))
    if constraint_os == "osx" and not link_library_directories:
        fail("mindclade Nix C/C++ toolchain requires pinned link library directories on Darwin")

    repository_ctx.symlink(manifest_path, "manifest.json")
    repository_ctx.file(
        "BUILD.bazel",
        """# Generated by //tools/build/bazel/extensions:nix_toolchains.bzl.
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load("@mindclade_internal//tools/build/bazel/toolchains/cc:defs.bzl", "mindclade_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

exports_files(["manifest.json"])

filegroup(
    name = "toolchain_files",
    srcs = {tool_files},
)

mindclade_cc_toolchain_config(
    name = "config",
    builtin_include_directories = {includes},
    compile_flags = {compile_flags},
    link_flags = {link_flags},
    system = {system},
    target_cpu = {target_cpu},
    target_triple = {target_triple},
    tools = {tools},
)

cc_toolchain(
    name = "cc_toolchain",
    all_files = ":toolchain_files",
    ar_files = ":toolchain_files",
    compiler_files = ":toolchain_files",
    dwp_files = ":toolchain_files",
    linker_files = ":toolchain_files",
    objcopy_files = ":toolchain_files",
    strip_files = ":toolchain_files",
    supports_param_files = 1,
    toolchain_config = ":config",
)

toolchain(
    name = "registered_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:{constraint_cpu}",
        "@platforms//os:{constraint_os}",
    ],
    target_compatible_with = [
        "@platforms//cpu:{constraint_cpu}",
        "@platforms//os:{constraint_os}",
    ],
    toolchain = ":cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
""".format(
            compile_flags = _quote(compile_flags),
            constraint_cpu = constraint_cpu,
            constraint_os = constraint_os,
            includes = _quote(includes),
            link_flags = _quote(link_flags),
            system = _quote(system),
            target_cpu = _quote(target_cpu),
            target_triple = _quote(target_triple),
            tool_files = _quote(sorted(generated_tools.values())),
            tools = _quote(generated_tools),
        ),
    )

_nix_cc_repository = repository_rule(
    implementation = _nix_cc_repository_impl,
    environ = ["MINDCLADE_CC_TOOLCHAIN_ROOT"],
    configure = True,
    local = True,
)

def _nix_toolchains_impl(_module_ctx):
    _nix_cc_repository(name = "mindclade_nix_cc")

nix_toolchains = module_extension(
    implementation = _nix_toolchains_impl,
)
