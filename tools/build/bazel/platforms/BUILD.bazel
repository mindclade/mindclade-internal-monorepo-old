package(default_visibility = ["//visibility:public"])

# GKE production node pools are linux/amd64. Container graphs transition here so a developer's
# host OS cannot leak its Python interpreter or native wheels into a Linux image.
platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)
