# Globbed rather than listed. The hand-maintained list had drifted to 14 of the 18 modules
# run_architecture_checks.py imports — check_affected_presubmit, check_artifact_gc_contract,
# check_cargo_bazel_alignment, check_foundation_hardening, check_go_layers and
# check_rust_implementation were all missing — so running this target died on ImportError
# naming a checker nobody had touched. The checkers are stdlib-only single files in one
# directory, so a glob cannot drift the way the list did.
py_binary(
    name = "architecture_policy",
    srcs = glob(
        ["*.py"],
        exclude = ["**/__pycache__/**"],
    ),
    main = "run_architecture_checks.py",
    visibility = ["//visibility:public"],
    deps = [
        "//ci/common:affected",
        "//ci/common:affected_contract",
        "//ci/nightly:pipeline_lib",
        "//ci/presubmit:pipeline_lib",
        "//configs:contract_validation",
        "//infra/observability:alert_contracts",
        # The generated-artifact gate is the one checker that does not live in this directory,
        # so the glob above cannot supply it. It is declared here for the same reason the glob
        # replaced a hand-written srcs list: a checker this target imports but does not depend
        # on fails analysis, and the failure names a file nobody touched.
        "//tools/codegen:verify_generated_lib",
        "//tools/qualification:release_evidence",
    ],
)
