{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.com/contracts/qualification/training-platform-1.0.0.schema.json",
  "title": "Mindclade connected training-platform qualification set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_digest",
    "cohort_digest",
    "policy_digest",
    "policy",
    "smoke_evidence_digest",
    "target_runs",
    "summary",
    "artifacts",
    "approvals"
  ],
  "properties": {
    "schema_version": {"const": "mindclade.dev/training-platform-qualification/v1"},
    "subject_digest": {"$ref": "#/$defs/digest"},
    "cohort_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "smoke_evidence_digest": {"$ref": "#/$defs/digest"},
    "policy": {"$ref": "#/$defs/policy"},
    "target_runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/target_run"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "approvals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/approval"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_target_runs",
        "completion_objective_ppm",
        "approved_thresholds_digest"
      ],
      "properties": {
        "minimum_target_runs": {"type": "integer", "minimum": 30, "maximum": 10000},
        "completion_objective_ppm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "approved_thresholds_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "target_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "cohort_digest",
        "phase",
        "capacity_type",
        "attempt_count",
        "started_unix_millis",
        "terminal_unix_millis",
        "outcome",
        "evidence_digest"
      ],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
        "cohort_digest": {"$ref": "#/$defs/digest"},
        "phase": {"const": "h100-8g-ddp-dcp"},
        "capacity_type": {"const": "on-demand"},
        "attempt_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "started_unix_millis": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "terminal_unix_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "outcome": {
          "type": "string",
          "enum": [
            "deadline_exceeded",
            "failed",
            "platform_failure",
            "pre_admission_rejected",
            "succeeded",
            "user_canceled"
          ]
        },
        "evidence_digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": {"outcome": {"const": "pre_admission_rejected"}}
          },
          "then": {"properties": {"started_unix_millis": {"const": null}}},
          "else": {
            "properties": {
              "started_unix_millis": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_runs",
        "successful_runs",
        "excluded_pre_admission",
        "excluded_user_cancellations",
        "completion_ratio_ppm",
        "subject_digest"
      ],
      "properties": {
        "eligible_runs": {"type": "integer", "minimum": 1, "maximum": 10000},
        "successful_runs": {"type": "integer", "minimum": 0, "maximum": 10000},
        "excluded_pre_admission": {"type": "integer", "minimum": 0, "maximum": 10000},
        "excluded_user_cancellations": {"type": "integer", "minimum": 0, "maximum": 10000},
        "completion_ratio_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "subject_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alert_fire_resolve",
        "checkpoint_resume",
        "cost_qualification",
        "h100_1g_qualification",
        "h100_8g_qualification",
        "lineage",
        "numerical_qualification",
        "performance",
        "reliability_qualification",
        "rollback_drill",
        "scale",
        "security_qualification",
        "slo_approval",
        "vulnerability_scan"
      ],
      "properties": {
        "alert_fire_resolve": {"$ref": "#/$defs/digest"},
        "checkpoint_resume": {"$ref": "#/$defs/digest"},
        "cost_qualification": {"$ref": "#/$defs/digest"},
        "h100_1g_qualification": {"$ref": "#/$defs/digest"},
        "h100_8g_qualification": {"$ref": "#/$defs/digest"},
        "lineage": {"$ref": "#/$defs/digest"},
        "numerical_qualification": {"$ref": "#/$defs/digest"},
        "performance": {"$ref": "#/$defs/digest"},
        "reliability_qualification": {"$ref": "#/$defs/digest"},
        "rollback_drill": {"$ref": "#/$defs/digest"},
        "scale": {"$ref": "#/$defs/digest"},
        "security_qualification": {"$ref": "#/$defs/digest"},
        "slo_approval": {"$ref": "#/$defs/digest"},
        "vulnerability_scan": {"$ref": "#/$defs/digest"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team",
        "decision",
        "subject_digest",
        "policy_digest",
        "approved_thresholds_digest",
        "decision_digest"
      ],
      "properties": {
        "team": {
          "type": "string",
          "enum": ["finops", "sre", "training-platform"]
        },
        "decision": {"const": "approved"},
        "subject_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "approved_thresholds_digest": {"$ref": "#/$defs/digest"},
        "decision_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
