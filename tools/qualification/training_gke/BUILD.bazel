load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "templates",
    srcs = [
        "h100-1g-smoke.json",
        "h100-8g-ddp-dcp.json",
    ],
)

py_library(
    name = "run_lib",
    srcs = ["run.py"],
    data = [":templates"],
    imports = ["../../.."],
)

py_binary(
    name = "run",
    srcs = ["run.py"],
    data = [":templates"],
    imports = ["../../.."],
    visibility = ["//visibility:public"],
)

pytest_test(
    name = "test_run",
    srcs = ["tests/test_run.py"],
    imports = ["../../../.."],
    deps = [":run_lib"],
)
