load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "autotune_tilelang",
    srcs = ["autotune_tilelang.py"],
    imports = ["../../.."],
    main = "autotune_tilelang.py",
    deps = ["//kernels/tilelang/autotune"],
)

pytest_test(
    name = "test_kernel_tools",
    srcs = [
        "autotune_tilelang.py",
        "inspect_tilelang_ir.py",
        "qualify_tilelang.py",
        "test_kernel_tools.py",
        "verify_tilelang_manifest.py",
