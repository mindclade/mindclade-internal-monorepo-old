    imports = ["../../.."],
    deps = [
        "//kernels:kernel_core",
        "//kernels/qualification",
        "//kernels/tilelang/autotune",
        "//kernels/tilelang/compiler",
    ],
)

py_binary(
    name = "inspect_tilelang_ir",
    srcs = ["inspect_tilelang_ir.py"],
    imports = ["../../.."],
    main = "inspect_tilelang_ir.py",
    deps = ["//kernels/tilelang/compiler"],
)

py_binary(
    name = "qualify_tilelang",
    srcs = ["qualify_tilelang.py"],
    imports = ["../../.."],
    main = "qualify_tilelang.py",
    deps = [
        "//kernels:kernel_core",
        "//kernels/qualification",
    ],
)

py_binary(
    name = "verify_tilelang_manifest",
    srcs = ["verify_tilelang_manifest.py"],
    imports = ["../../.."],
    main = "verify_tilelang_manifest.py",
    deps = ["//kernels:kernel_core"],
