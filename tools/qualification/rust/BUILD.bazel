load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "release_performance_lib",
    srcs = ["release_performance.py"],
    imports = ["../../.."],
)

py_binary(
    name = "qualify",
    srcs = [
        "common.py",
        "qualify.py",
    ],
    main = "qualify.py",
    visibility = ["//visibility:public"],
)

pytest_test(
    name = "test_release_performance",
    srcs = ["tests/test_release_performance.py"],
    imports = ["../../.."],
    deps = [":release_performance_lib"],
)

exports_files([
    "README.md",
    "fuzz.py",
    "miri.py",
    "qualify_parsers.py",
    "qualify_runtime.py",
    "qualify_storage.py",
    "sanitizers.py",
])
