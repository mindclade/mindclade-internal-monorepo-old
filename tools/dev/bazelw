#
# The repository's Bazel entry point.
#
# WHAT THIS REPLACED. A 34-byte file reading `# Scaffold file: tools/dev/bazelw`, without an
# executable bit, which ci/presubmit/pipeline.py invokes as a program:
#
#     return run([str(REPO / "tools/dev/bazelw"), "test", *targets])
#
# That call raises PermissionError. Nothing had noticed because presubmit.yml runs
# `pipeline.py --static-only`, which returns before reaching that line, and because until the
# rules_go/Go 1.26 fix no Go target could be built by Bazel at all — so the lane that would
# have hit it was not worth turning on. Both of those are now false.
#
# WHY A WRAPPER RATHER THAN CALLING bazel DIRECTLY. Three reasons, and none is style:
#
#   1. The Nix shell ships the exact Bazel release declared by versions.nix. This script verifies
#      it against .bazelversion before use. Bazelisk remains a compatibility fallback outside
#      Nix, where it reads the same pin; an unrelated host Bazel cannot silently own the graph.
#   2. Bazel resolves the workspace from the working directory. `pipeline.py` already passes
#      cwd=REPO, but a person running this from a subdirectory should get the same build, so
#      the cd here is not redundant with that.
#   3. The registered toolchain reads MINDCLADE_CC_TOOLCHAIN_ROOT from the Nix shell. The
#      launcher deliberately does not translate compiler flags: toolchain configuration is
#      analysis data, not shell behavior.
#
# WHAT THIS DELIBERATELY DOES NOT DO: choose a build mode or target set. No --config=ci and no
# implicit //... . The caller still owns build semantics.

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cd -- "${repo_root}"

# Nix-owned Bazel first. Bazelisk is retained only for developer compatibility outside the
# shell; it reads the same .bazelversion and downloads the corresponding signed release.
pinned_version="$(tr -d '[:space:]' < .bazelversion)"
if command -v bazel >/dev/null 2>&1; then
  candidate="$(command -v bazel)"
  actual_version="$("${candidate}" --version)"
  if [[ -n "${pinned_version}" ]] &&
    { [[ "${actual_version}" == "bazel ${pinned_version}" ]] ||
      [[ "${actual_version}" == "bazel ${pinned_version}- (@non-git)" ]]; }; then
    bazel_launcher="${candidate}"
  elif command -v bazelisk >/dev/null 2>&1; then
    bazel_launcher="$(command -v bazelisk)"
  else
    echo "error: ${candidate} reports '${actual_version}'; this repository requires 'bazel ${pinned_version:-<non-empty .bazelversion>}'" >&2
    echo "enter the Nix development shell or install Bazelisk" >&2
    exit 2
  fi
elif command -v bazelisk >/dev/null 2>&1; then
  bazel_launcher="$(command -v bazelisk)"
else
  cat >&2 <<'ERROR'
error: neither bazelisk nor bazel is on PATH.

The development shells in flake.nix provide the exact Bazel binary:

    tools/dev/nixw develop          # or: tools/dev/nixw develop .#ci
    direnv allow                    # to load it automatically in this tree

Outside Nix, Bazelisk reads .bazelversion and fetches that same release.
ERROR
  exit 127
fi

exec "${bazel_launcher}" "$@"
