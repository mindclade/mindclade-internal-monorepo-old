load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//services/control_plane:__subpackages__"])

go_library(
    name = "config",
    srcs = [
        "config.go",
        "validation.go",
    ],
    importpath = "mindclade.internal/services/control_plane/internal/config",
    deps = [
        "//libs/go/config",
        "//libs/go/faults",
        "//libs/go/signing",
    ],
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":config"],
    deps = [
        "//libs/go/config",
        "//libs/go/faults",
    ],
)
