load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//services/control_plane:__subpackages__"])

go_library(
    name = "postgres",
    srcs = [
        "config.go",
        "ddl.go",
        "descriptors.go",
        "doc.go",
        "evidence.go",
        "errors.go",
        "releases.go",
        "store.go",
    ],
    importpath = "go.mindclade.dev/services/control_plane/internal/store/postgres",
    deps = [
        "//control/evidence",
        "//control/registry/models",
        "//control/registry/releases",
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/storage/sql/postgres",
        "//libs/go/storage/sql/transaction",
    ],
)

go_test(
    name = "postgres_test",
    srcs = [
        "ddl_test.go",
        "descriptors_test.go",
        "live_postgres_test.go",
        "releases_test.go",
    ],
    embed = [":postgres"],
    deps = [
        "//control/artifacts",
        "//control/evidence",
        "//control/registry/models",
        "//control/registry/releases",
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/signing",
        "//libs/go/storage/lease",
        "//libs/go/storage/lease/postgres",
        "//libs/go/storage/sql/sqltest",
        "//libs/go/storage/sql/transaction",
        "@com_github_lib_pq//:pq",
    ],
)
