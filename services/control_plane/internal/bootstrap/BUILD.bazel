load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//services/control_plane:__subpackages__"])

exports_files(["README.md"])

go_library(
    name = "bootstrap",
    srcs = [
        "bootstrap.go",
        "build.go",
        "capabilities.go",
        "components.go",
        "consumption.go",
        "foundation.go",
        "profile.go",
    ],
    embedsrcs = ["consumption.json"],
    importpath = "go.mindclade.dev/services/control_plane/internal/bootstrap",
    deps = [
        "//libs/go/faults",
        "//libs/go/servicekit",
        "//libs/go/servicekit/production",
    ],
)

go_test(
    name = "bootstrap_test",
    srcs = [
        "command_test.go",
        "profile_test.go",
        "promotion_test.go",
    ],
    data = [
        "//services/control_plane/cmd/admin:sources",
        "//services/control_plane/cmd/api:sources",
        "//services/control_plane/cmd/controller:sources",
        "//services/control_plane/cmd/event_dispatcher:sources",
        "//services/control_plane/cmd/event_projector:sources",
        "//services/control_plane/cmd/ingestion_controller:sources",
        "//services/control_plane/cmd/maintenance:sources",
        "//services/control_plane/cmd/operator:sources",
        "//services/control_plane/cmd/registry:sources",
        "//services/control_plane/cmd/scheduler:sources",
        "//services/control_plane/cmd/webhook_dispatcher:sources",
    ],
    embed = [":bootstrap"],
    deps = [
        "//libs/go/faults",
        "//libs/go/servicekit",
        "//libs/go/servicekit/production",
    ],
)
