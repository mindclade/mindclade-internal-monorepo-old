load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//services/control_plane:__subpackages__"])

exports_files(["README.md"])

go_library(
    name = "bootstrap",
    srcs = ["bootstrap.go", "build.go", "capabilities.go", "components.go", "consumption.go", "foundation.go", "profile.go"],
