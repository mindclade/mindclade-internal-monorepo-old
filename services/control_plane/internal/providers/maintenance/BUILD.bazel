    srcs = ["maintenance.go"],
    importpath = "go.mindclade.dev/services/control_plane/internal/providers/maintenance",
    deps = [
        "//libs/go/config",
        "//libs/go/coordination/leadership",
        "//libs/go/coordination/workqueue",
        "//libs/go/faults",
        "//libs/go/servicekit",
        "//libs/go/storage/lease",
