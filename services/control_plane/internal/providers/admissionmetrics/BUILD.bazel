load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//services/control_plane:__subpackages__"])

go_library(
    name = "admissionmetrics",
    srcs = [
        "metrics.go",
        "server.go",
    ],
    importpath = "go.mindclade.dev/services/control_plane/internal/providers/admissionmetrics",
    deps = [
        "//libs/go/faults",
        "//libs/go/httpx",
        "//libs/go/servicekit",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
    ],
)

go_test(
    name = "admissionmetrics_test",
    srcs = ["metrics_test.go"],
    embed = [":admissionmetrics"],
    deps = [
        "//libs/go/faults",
    ],
)
