load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//services/control_plane:__subpackages__"])

go_library(
    name = "controller",
    srcs = [
        "controller.go",
        "manager.go",
    ],
    importpath = "go.mindclade.dev/services/control_plane/internal/providers/controller",
    deps = [
        "//libs/go/config",
        "//libs/go/coordination/leadership",
        "//libs/go/faults",
        "//libs/go/kubernetes/controller",
        "//libs/go/kubernetes/events",
        "//libs/go/servicekit",
        "//libs/go/storage/lease",
        "//services/control_plane/internal/bootstrap",
        "//services/control_plane/internal/config",
        "//services/control_plane/internal/foundation",
        "//services/control_plane/internal/foundation/eventing",
        "//services/control_plane/internal/foundation/governance",
        "//services/control_plane/internal/foundation/leasing",
        "//services/control_plane/internal/foundation/orchestration",
        "//services/control_plane/internal/foundation/persistence",
        "//services/control_plane/internal/foundation/tasks",
        "//services/control_plane/internal/providers",
        "//services/control_plane/internal/providers/broker",
        "//services/control_plane/internal/providers/cluster",
        "//services/control_plane/internal/providers/durable",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/manager",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/server",
    ],
)

go_test(
    name = "controller_test",
    srcs = ["controller_test.go"],
    embed = [":controller"],
    deps = [
        "//libs/go/config",
        "//libs/go/faults",
        "//services/control_plane/internal/bootstrap",
        "@com_github_lib_pq//:pq",
    ],
)
