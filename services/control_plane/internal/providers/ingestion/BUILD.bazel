load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//services/control_plane:__subpackages__"])

go_library(
    name = "ingestion",
    srcs = ["ingestion.go"],
    importpath = "go.mindclade.dev/services/control_plane/internal/providers/ingestion",
    deps = [
        "//libs/go/config",
        "//libs/go/coordination/leadership",
        "//libs/go/coordination/workqueue",
        "//libs/go/faults",
        "//libs/go/servicekit",
        "//libs/go/storage/lease",
