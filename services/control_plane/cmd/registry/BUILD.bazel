load("@rules_go//go:def.bzl", "go_binary", "go_library")

package(default_visibility = ["//visibility:private"])

# The whole compiled package, not just main.go. The promotion tests in
# //services/control_plane/internal/bootstrap read every non-test file that
# reaches the binary, because a sibling file in this package is the same
# binary and can hold exactly what main.go is forbidden to hold. Staging one
# filename would make the Bazel run of those tests a rule about a filename.
filegroup(
    name = "sources",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    visibility = ["//services/control_plane/internal/bootstrap:__pkg__"],
)

go_binary(
    name = "registry",
    embed = [":registry_lib"],
    importpath = "go.mindclade.dev/services/control_plane/cmd/registry",
    visibility = ["//services/control_plane:__subpackages__"],
)

go_library(
    name = "registry_lib",
    srcs = ["main.go"],
    importpath = "go.mindclade.dev/services/control_plane/cmd/registry",
    deps = [
        "//services/control_plane/internal/bootstrap",
        "//services/control_plane/internal/providers/registry",
        "@com_github_lib_pq//:pq",
    ],
)

# Cross-compiled sibling of `:registry`, and the only input to the release image.
#
# `:registry` above is configured for the host, so on a developer Mac it produces a darwin
# binary that a linux/amd64 image cannot execute. Fixing the platform here rather than on the
# oci_image keeps the image's contents independent of the machine that builds it, which is the
# property a release needs: identical bytes from a laptop and from a Linux runner.
#
# pure = "on" removes the cgo dependency so the binary runs on distroless static, which ships
# no libc. `-s -w` drop the symbol and DWARF tables; nothing in the release path debugs this
# binary in place, and the crash path is the structured log, not a core dump.
go_binary(
    name = "registry_linux_amd64",
    embed = [":registry_lib"],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    goarch = "amd64",
    goos = "linux",
    pure = "on",
    visibility = ["//services/control_plane:__pkg__"],
)
