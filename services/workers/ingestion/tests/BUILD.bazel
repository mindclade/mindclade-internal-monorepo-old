load("@rules_rust//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:private"])

# Declared HERE rather than in the parent package, because this directory carries its own
# BUILD.bazel and is therefore its own package — a `srcs = ["tests/integration.rs"]` one level
# up crosses that boundary and Bazel refuses to evaluate `//...` at all.
rust_test(
    name = "integration",
    srcs = ["integration.rs"],
    edition = "2024",
    deps = [
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "//libs/rust/worker_protocol:mindclade_worker_protocol",
        "//libs/rust/worker_runtime:mindclade_worker_runtime",
    ],
)

filegroup(
    name = "scaffold_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
