load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "model_worker",
    srcs = glob(
        ["*.py"],
        exclude = ["tests/**"],
    ),
    imports = ["../../.."],
    deps = [
        "//libs/python/errors",
        "//libs/python/worker_runtime",
        "//models/reference:affine",
        "//protocols/proto/mindclade/runtime/v1:runtime_worker_py_pb2",
        "//serving/contracts",
        "//serving/model_worker",
    ],
)

py_binary(
    name = "model_worker_bin",
    srcs = ["main.py"],
    legacy_create_init = False,
    main = "main.py",
    deps = [":model_worker"],
)
