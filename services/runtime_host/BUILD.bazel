load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//libs/rust:repo_consumers"])

rust_library(
    name = "mindclade_runtime_host",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mindclade_runtime_host",
    edition = "2024",
    deps = [
        "//libs/rust/bytes_io:mindclade_bytes_io",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/gpu_host:mindclade_gpu_host",
        "//libs/rust/ipc:mindclade_ipc",
        "//libs/rust/ipc_os:mindclade_ipc_os",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "//libs/rust/servicekit:mindclade_servicekit",
        "//libs/rust/telemetry:mindclade_telemetry",
        "//libs/rust/worker_protocol:mindclade_worker_protocol",
        "//libs/rust/worker_runtime:mindclade_worker_runtime",
        "//protocols/rust:mindclade_protocols",
        "//serving/runtime:mindclade_serving_runtime",
        "@crates//:bytes",
        "@crates//:prost",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "mindclade_runtime_host_bin",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mindclade_runtime_host_bin",
    edition = "2024",
    deps = [
        ":mindclade_runtime_host",
        "//libs/rust/bytes_io:mindclade_bytes_io",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/gpu_host:mindclade_gpu_host",
        "//libs/rust/ipc:mindclade_ipc",
        "//libs/rust/ipc_os:mindclade_ipc_os",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "//libs/rust/servicekit:mindclade_servicekit",
        "//libs/rust/telemetry:mindclade_telemetry",
        "//libs/rust/worker_protocol:mindclade_worker_protocol",
        "//libs/rust/worker_runtime:mindclade_worker_runtime",
        "//protocols/rust:mindclade_protocols",
        "//serving/runtime:mindclade_serving_runtime",
        "@crates//:bytes",
        "@crates//:prost",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "integration",
    srcs = ["tests/integration.rs"],
    edition = "2024",
    deps = [
        "//libs/rust/bytes_io:mindclade_bytes_io",
        # tests/integration.rs calls hash_bytes directly. Declared here and as a Cargo
        # dev-dependency, not on the library: architecture/dependency_budgets.toml governs what
        # this service ships with, and check_cargo_bazel_alignment only reads [dependencies], so
        # nothing else would notice this label missing.
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/gpu_host:mindclade_gpu_host",
        "//libs/rust/identifiers:mindclade_identifiers",
        "//libs/rust/ipc:mindclade_ipc",
        "//libs/rust/ipc_os:mindclade_ipc_os",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "//libs/rust/servicekit:mindclade_servicekit",
        "//libs/rust/telemetry:mindclade_telemetry",
        "//libs/rust/worker_protocol:mindclade_worker_protocol",
        "//libs/rust/worker_runtime:mindclade_worker_runtime",
        "//protocols/rust:mindclade_protocols",
        "//serving/runtime:mindclade_serving_runtime",
        ":mindclade_runtime_host",
        "@crates//:bytes",
        "@crates//:prost",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "shutdown",
    srcs = ["tests/shutdown.rs"],
    edition = "2024",
    deps = [
        ":mindclade_runtime_host",
        "//libs/rust/bytes_io:mindclade_bytes_io",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/gpu_host:mindclade_gpu_host",
        "//libs/rust/identifiers:mindclade_identifiers",
        "//libs/rust/ipc:mindclade_ipc",
        "//libs/rust/ipc_os:mindclade_ipc_os",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "//libs/rust/servicekit:mindclade_servicekit",
        "//libs/rust/telemetry:mindclade_telemetry",
        "//libs/rust/worker_protocol:mindclade_worker_protocol",
        "//libs/rust/worker_runtime:mindclade_worker_runtime",
        "//protocols/rust:mindclade_protocols",
        "//serving/runtime:mindclade_serving_runtime",
        "@crates//:bytes",
        "@crates//:prost",
        "@crates//:tokio",
    ],
)

filegroup(
    name = "package_sources",
    srcs = glob(
        ["**"],
        exclude = ["target/**"],
    ),
    visibility = ["//libs/rust:repo_consumers"],
)
