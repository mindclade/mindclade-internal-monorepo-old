load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "retry",
    srcs = [
        "attempt.go",
        "backoff.go",
        "doc.go",
        "errors.go",
        "executor.go",
        "jitter.go",
        "observer.go",
