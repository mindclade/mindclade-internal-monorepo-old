load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

exports_files(["README.md"])

go_library(
    name = "pagination",
    srcs = [
        "codec.go",
        "cursor.go",
        "doc.go",
        "errors.go",
        "request.go",
    ],
    importpath = "go.mindclade.dev/libs/go/pagination",
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/signing",
