load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "migrations/000001_workqueue.up.sql",
    "migrations/000001_workqueue.down.sql",
])

go_library(
    name = "postgres",
    srcs = ["doc.go", "store.go"],
    importpath = "mindclade.internal/libs/go/coordination/workqueue/postgres",
    deps = [
        "//libs/go/coordination",
        "//libs/go/coordination/workqueue",
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/requestmeta",
        "//libs/go/storage/sql/postgres",
        "//libs/go/storage/sql/transaction",
    ],
)

go_test(
    name = "postgres_test",
    srcs = ["store_test.go"],
    embed = [":postgres"],
    deps = [
        "//libs/go/coordination/workqueue/workqueuetest",
        "//libs/go/storage/sql/sqltest",
    ],
)
