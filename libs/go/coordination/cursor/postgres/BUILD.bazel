load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "migrations/000001_cursors.up.sql",
    "migrations/000001_cursors.down.sql",
])

go_library(
    name = "postgres",
    srcs = ["doc.go", "store.go"],
    importpath = "go.mindclade.dev/libs/go/coordination/cursor/postgres",
    deps = [
        "//libs/go/coordination/cursor",
        "//libs/go/faults",
        "//libs/go/storage/sql/postgres",
        "//libs/go/storage/sql/transaction",
    ],
)

go_test(
    name = "postgres_test",
    srcs = ["store_test.go"],
    embed = [":postgres"],
    deps = [
        "//libs/go/coordination/cursor/cursortest",
        "//libs/go/storage/sql/sqltest",
    ],
)
