load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "outbox",
    srcs = [
        "claim.go",
        "dispatcher.go",
        "doc.go",
        "errors.go",
        "factory.go",
        "message.go",
        "publisher.go",
        "store.go",
