    ],
    embed = [":outbox"],
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/requestmeta",
        "//libs/go/retry",
        "//libs/go/coordination/outbox/memory",
    ],
