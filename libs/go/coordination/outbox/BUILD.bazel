load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "outbox",
    srcs = [
        "claim.go",
        "dispatcher.go",
        "doc.go",
        "errors.go",
        "factory.go",
        "message.go",
        "publisher.go",
        "store.go",
    ],
    importpath = "go.mindclade.dev/libs/go/coordination/outbox",
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/identifiers",
        "//libs/go/requestmeta",
        "//libs/go/retry",
        "//libs/go/servicekit",
        "//libs/go/storage/lease",
    ],
)

go_test(
    name = "outbox_test",
    srcs = [
        "dispatcher_test.go",
        "message_test.go",
    ],
    embed = [":outbox"],
    deps = [
        "//libs/go/clock",
        "//libs/go/coordination/outbox/memory",
        "//libs/go/coordination/outbox/outboxtest",
        "//libs/go/identifiers",
        "//libs/go/requestmeta",
        "//libs/go/storage/lease",
    ],
)
