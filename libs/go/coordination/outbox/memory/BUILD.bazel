load("@rules_go//go:def.bzl", "go_library", "go_test")
package(default_visibility = ["//visibility:public"])

go_library(
    name = "memory",
    srcs = ["doc.go", "store.go"],
    importpath = "mindclade.internal/libs/go/coordination/outbox/memory",
    deps = [
        "//libs/go/clock",
        "//libs/go/coordination/outbox",
        "//libs/go/faults",
        "//libs/go/storage/lease",
    ],
)

go_test(
    name = "memory_test",
    srcs = ["store_test.go"],
    embed = [":memory"],
    deps = [
        "//libs/go/clock",
        "//libs/go/coordination/outbox",
        "//libs/go/coordination/outbox/outboxtest",
    ],
)
