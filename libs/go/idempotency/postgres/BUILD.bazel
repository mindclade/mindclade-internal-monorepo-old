load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "migrations/000001_idempotency.up.sql",
    "migrations/000001_idempotency.down.sql",
])

go_library(
    name = "postgres",
    srcs = ["config.go", "doc.go", "errors.go", "store.go"],
    importpath = "mindclade.internal/libs/go/idempotency/postgres",
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/idempotency",
        "//libs/go/identifiers",
        "//libs/go/requestmeta",
        "//libs/go/storage/sql/postgres",
        "//libs/go/storage/sql/transaction",
    ],
)

go_test(
    name = "postgres_test",
    srcs = ["config_test.go", "store_test.go"],
    embed = [":postgres"],
    deps = [
        "//libs/go/clock",
        "//libs/go/idempotency",
        "//libs/go/identifiers",
        "//libs/go/storage/sql/sqltest",
    ],
)
