load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "memory",
    srcs = [
        "doc.go",
        "store.go",
    ],
    importpath = "mindclade.internal/libs/go/storage/cache/memory",
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/storage/cache",
    ],
)

go_test(
    name = "memory_test",
    srcs = [
        "conformance_test.go",
        "store_test.go",
    ],
    embed = [":memory"],
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
        "//libs/go/storage/cache",
        "//libs/go/storage/cache/cachetest",
    ],
)
