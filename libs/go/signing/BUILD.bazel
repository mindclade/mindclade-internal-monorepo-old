load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

exports_files(["README.md"])

go_library(
    name = "signing",
    srcs = [
        "algorithm.go",
        "doc.go",
        "domain.go",
        "ed25519.go",
        "errors.go",
        "faults.go",
        "hmac.go",
        "key.go",
        "keyset.go",
        "signature.go",
        "signer.go",
    ],
    importpath = "go.mindclade.dev/libs/go/signing",
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
    ],
)

go_test(
    name = "signing_test",
    srcs = [
        "domain_test.go",
        "signing_test.go",
    ],
    embed = [":signing"],
    deps = ["//libs/go/clock"],
)
