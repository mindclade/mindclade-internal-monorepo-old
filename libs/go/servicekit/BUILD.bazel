load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "servicekit",
    srcs = [
        "assembly.go",
        "build.go",
        "component.go",
        "doc.go",
        "errors.go",
        "event.go",
        "faults.go",
        "internal.go",
        "options.go",
        "probe.go",
        "service.go",
        "shutdown.go",
        "signal.go",
        "signal_unix.go",
        "signal_windows.go",
        "state.go",
        "task.go",
        "taskgroup.go",
        "timeout.go",
    ],
    importpath = "go.mindclade.dev/libs/go/servicekit",
    deps = [
