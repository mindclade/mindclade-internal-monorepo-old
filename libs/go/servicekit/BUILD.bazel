    srcs = [
        "assembly_test.go",
        "build_test.go",
        "clock_test.go",
        "component_test.go",
        "errors_test.go",
        "event_test.go",
        "lifecycle_contract_test.go",
        "options_test.go",
        "probe_test.go",
        "service_test.go",
        "signal_test.go",
        "state_test.go",
        "taskgroup_test.go",
    ],
    embed = [":servicekit"],
    deps = [
        "//libs/go/clock",
        "//libs/go/faults",
    ],
