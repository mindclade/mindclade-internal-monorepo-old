load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

exports_files(["README.md"])

go_library(
    name = "production",
    srcs = [
        "builder.go",
        "capability.go",
        "doc.go",
        "manifest.go",
        "plan.go",
        "profile.go",
        "role.go",
