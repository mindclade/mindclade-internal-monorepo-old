load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:private"])

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig_chain",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_project(
    name = "typescript",
    srcs = glob(["src/**/*.ts"]),
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    root_dir = "src",
    source_map = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig_chain",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@mindclade/sdk-typescript",
        "//sdk/typescript",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":typescript",
    ],
    visibility = ["//visibility:public"],
)
