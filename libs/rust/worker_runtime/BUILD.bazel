load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//libs/rust:repo_consumers"])

rust_library(
    name = "mindclade_worker_runtime",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mindclade_worker_runtime",
    edition = "2024",
    deps = [
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "//libs/rust/worker_protocol:mindclade_worker_protocol",
    ],
)

rust_test(
    name = "failure_injection",
    srcs = ["tests/failure_injection.rs"],
    edition = "2024",
    deps = [
        ":mindclade_worker_runtime",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "//libs/rust/worker_protocol:mindclade_worker_protocol",
