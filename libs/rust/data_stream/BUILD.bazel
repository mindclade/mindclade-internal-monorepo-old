load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//libs/rust:repo_consumers"])

rust_library(
    name = "mindclade_data_stream",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mindclade_data_stream",
    edition = "2024",
    deps = [
        "//libs/rust/bytes_io:mindclade_bytes_io",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/identifiers:mindclade_identifiers",
        "//libs/rust/object_store:mindclade_object_store",
        "//libs/rust/record_io:mindclade_record_io",
        "//libs/rust/runtime_core:mindclade_runtime_core",
    ],
)

rust_test(
    name = "integration",
    srcs = ["tests/integration.rs"],
    edition = "2024",
    deps = [
        "//libs/rust/bytes_io:mindclade_bytes_io",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/identifiers:mindclade_identifiers",
        "//libs/rust/object_store:mindclade_object_store",
        "//libs/rust/record_io:mindclade_record_io",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        ":mindclade_data_stream",
    ],
)

rust_test(
    name = "resume",
    srcs = ["tests/resume.rs"],
    edition = "2024",
    deps = [
        "//libs/rust/bytes_io:mindclade_bytes_io",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/identifiers:mindclade_identifiers",
        "//libs/rust/object_store:mindclade_object_store",
        "//libs/rust/record_io:mindclade_record_io",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        ":mindclade_data_stream",
    ],
)

filegroup(
    name = "package_sources",
    srcs = glob(["**"], exclude = ["target/**"]),
    visibility = ["//libs/rust:repo_consumers"],
)
