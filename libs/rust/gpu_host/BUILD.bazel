load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//libs/rust:repo_consumers"])

rust_library(
    name = "mindclade_gpu_host",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mindclade_gpu_host",
    edition = "2024",
    deps = [
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/runtime_core:mindclade_runtime_core",
    ],
)

rust_test(
    name = "budget",
    srcs = ["tests/budget.rs"],
    edition = "2024",
    deps = [
        ":mindclade_gpu_host",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/runtime_core:mindclade_runtime_core",
    ],
)

rust_test(
    name = "integration",
    srcs = ["tests/integration.rs"],
    edition = "2024",
    deps = [
        ":mindclade_gpu_host",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/runtime_core:mindclade_runtime_core",
    ],
)

rust_test(
    name = "inventory",
    srcs = ["tests/inventory.rs"],
    edition = "2024",
    deps = [
        ":mindclade_gpu_host",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/runtime_core:mindclade_runtime_core",
    ],
)

rust_test(
    name = "memory",
    srcs = ["tests/memory.rs"],
    edition = "2024",
    deps = [
        ":mindclade_gpu_host",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/runtime_core:mindclade_runtime_core",
    ],
)

filegroup(
    name = "package_sources",
    srcs = glob(
        ["**"],
        exclude = ["target/**"],
    ),
    visibility = ["//libs/rust:repo_consumers"],
)
