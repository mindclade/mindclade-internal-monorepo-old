load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//libs/rust:repo_consumers"])

rust_library(
    name = "mindclade_worker_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mindclade_worker_protocol",
    edition = "2024",
    deps = [
        "//libs/rust/bytes_io:mindclade_bytes_io",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/identifiers:mindclade_identifiers",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "@crates//:ed25519-dalek",
    ],
)

rust_test(
    name = "cross_language",
    srcs = ["tests/cross_language.rs"],
    # include_bytes! is resolved by rustc at COMPILE time, so the fixture has to be an input
    # to the compile action -- compile_data, not data. As a runfile it would not exist yet
    # when this line is expanded, which is the error the missing entry produced.
    compile_data = ["//tests/integration/cross_language:execution_ticket_claims_v1"],
    edition = "2024",
    deps = [
        ":mindclade_worker_protocol",
        "//libs/rust/bytes_io:mindclade_bytes_io",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/identifiers:mindclade_identifiers",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "@crates//:ed25519-dalek",
    ],
)

