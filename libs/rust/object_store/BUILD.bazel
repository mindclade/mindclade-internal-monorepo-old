load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//libs/rust:repo_consumers"])

rust_library(
    name = "mindclade_object_store",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mindclade_object_store",
    edition = "2024",
    deps = [
        "//libs/rust/atomic_fs:mindclade_atomic_fs",
        "//libs/rust/bytes_io:mindclade_bytes_io",
        "//libs/rust/content_digest:mindclade_content_digest",
        "//libs/rust/faults:mindclade_faults",
        "//libs/rust/runtime_core:mindclade_runtime_core",
        "@crates//:bytes",
        "@crates//:object_store",
    ],
)

