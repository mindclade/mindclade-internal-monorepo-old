load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

[
    pytest_test(
        name = source.removesuffix(".py"),
        srcs = [source],
        imports = ["../../../.."],
        deps = ["//libs/python/config"],
    )
    for source in [
        "test_loader.py",
        "test_merge.py",
        "test_resolved.py",
    ]
]
