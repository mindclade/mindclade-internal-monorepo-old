# The test target lives here rather than in the parent package because this
# directory carries its own BUILD.bazel and is therefore its own Bazel package —
# the parent cannot claim `tests/*.py` as srcs across that boundary.
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

pytest_test(
    name = "test_canonical",
    srcs = ["test_canonical.py"],
    imports = ["../../../.."],
    deps = ["//libs/python/serialization"],
)
