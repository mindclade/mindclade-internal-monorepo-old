load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

[
    pytest_test(
        name = source.removesuffix(".py"),
        srcs = [source],
        imports = ["../../../.."],
        deps = [
            "//libs/python/errors",
            "//libs/python/observability",
        ],
    )
    for source in [
        "test_redaction.py",
        "test_telemetry.py",
    ]
]
