load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "errors",
    srcs = [
        "__init__.py",
        "base.py",
        "codes.py",
        "retry.py",
    ],
    # py.typed rides in data, not srcs: it is a marker file rather than a module,
    # and a PEP 561 consumer only sees it if it reaches the runfiles tree.
    data = ["py.typed"],
    imports = ["../../.."],
)
