load("@rules_python//python:defs.bzl", "py_library")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "worker_runtime",
    srcs = [
        "__init__.py",
        "contracts.py",
        "executor.py",
        "workload.py",
    ],
    data = ["py.typed"],
    imports = ["../../.."],
    deps = [
        "//libs/python/errors",
        "//libs/python/identifiers",
    ],
)

# pytest_test, not py_test: tests/test_executor.py is a pytest module, and its src living in
# tests/ meant the default main "<name>.py" never appeared in srcs, so the target failed
# analysis outright rather than running anything.
pytest_test(
    name = "test_executor",
    srcs = ["tests/test_executor.py"],
    imports = ["../../.."],
    deps = [":worker_runtime"],
)

pytest_test(
    name = "test_workload",
    srcs = ["tests/test_workload.py"],
    imports = ["../../.."],
    deps = [":worker_runtime"],
)

pytest_test(
    name = "test_properties",
    srcs = ["tests/test_properties.py"],
    imports = ["../../.."],
    deps = [
        ":worker_runtime",
        "//libs/python/errors",
        "@pypi//hypothesis",
    ],
)
