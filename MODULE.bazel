module(
    name = "mindclade_internal",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "aspect_rules_js", version = "3.3.1")
bazel_dep(name = "aspect_rules_ts", version = "3.9.2")
bazel_dep(name = "bazel_lib", version = "3.2.2")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "protobuf", version = "33.4")

# rules_rust registers a default toolchain from its own module when the root is silent. That
# default happens to match today, but its version is not repository policy and can move with a
# rules_rust update. Root-module tags take precedence, so pin the Bazel compiler explicitly to
# the same version Cargo and Nix declare and make the Rust 2024 default unambiguous.
rust_toolchains = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust_toolchains.toolchain(
    edition = "2024",
    versions = ["1.97.1"],
)
use_repo(rust_toolchains, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# pnpm owns dependency resolution; Bazel translates the committed lock into
# lazy, integrity-checked repositories and links only declared package edges.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

# Native TypeScript 7 is the compilation authority. Next retains a package-local
# TypeScript 6 API only for programmatic route generation; it is not the Bazel
# compiler and cannot silently lower this gate.
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext", dev_dependency = True)
rules_ts_ext.deps(ts_version = "7.0.2")
use_repo(rules_ts_ext, "npm_typescript")

# Tar layers for oci_image. rules_oci deliberately does not build layers itself -- it composes
# images from tarballs -- so an image target needs this alongside it.
bazel_dep(name = "rules_pkg", version = "1.0.1")

# Bazel 9 removed the native sh_binary/sh_test/sh_library rules; they live in rules_shell now
# and must be loaded explicitly. //tools/qualification/go:validate is the only sh_ rule in the
# repository, and without this dep its package fails to LOAD -- which takes down `//...` for
# every target, not just that one.
#
# It resolves as a transitive dependency of aspect_bazel_lib regardless. Declaring it directly
# is what makes the load() legal: a transitive module is not addressable as @rules_shell from
# this repository's own BUILD files.
bazel_dep(name = "rules_shell", version = "0.6.1")

# Nix owns the compiler closure. This extension turns the bundle exported by every development
# shell into a registered C/C++ toolchain, so Bazel never probes /usr/bin, Xcode Command Line
# Tools, or Homebrew to discover build semantics.
nix_toolchains = use_extension(
    "//tools/build/bazel/extensions:nix_toolchains.bzl",
    "nix_toolchains",
)
use_repo(nix_toolchains, "mindclade_nix_cc")

register_toolchains("@mindclade_nix_cc//:registered_toolchain")

# Static infrastructure validation consumes fixed-hash Kubernetes schemas and captures the
# Nix-owned CLI closure as declared runfiles. The latter is a documented transition bridge:
# actions do not inherit PATH and remain sandboxed, while Nix remains the version authority.
infra_validation = use_extension(
    "//tools/build/bazel/extensions:infra_validation.bzl",
    "infra_validation",
)
use_repo(
    infra_validation,
    "mindclade_infra_validation_tools",
    "mindclade_kubernetes_schemas",
    "mindclade_terraform_google_provider",
)

# Rust third-party dependencies are derived from the canonical Cargo workspace.
#
# EVERY MEMBER MANIFEST IS LISTED, not just the root. This list and the `members` list in
# //:Cargo.toml are one roster expressed twice, and the only thing holding them together is
# tools/analysis/check_cargo_bazel_alignment.py, which compares them in both directions.
# `libs/rust/process_os` was missing here for as long as that checker did nothing but grep for
# the string `crate.from_cargo(` — a member Cargo built and Bazel's roster never named.
#
# An earlier note here said an omission makes the extension fail to evaluate with "Some
# manifests are not being tracked". That does not reproduce on rules_rust 0.73: it reports the
# opposite ("Only the workspace's Cargo.toml is required in the `manifests` attribute ... the
# rest can be removed"), and MODULE.bazel.lock records every member manifest as an extension
# input either way, because `cargo metadata` reaches them through the root. The enumeration is
# kept because it is the reviewable roster of the Rust workspace in the file a reader consults
# to find one — not because a build currently depends on it.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//libs/rust/artifact_cas:Cargo.toml",
        "//libs/rust/atomic_fs:Cargo.toml",
        "//libs/rust/bio_formats:Cargo.toml",
        "//libs/rust/bounded_parse:Cargo.toml",
        "//libs/rust/bytes_io:Cargo.toml",
        "//libs/rust/checkpoint_io:Cargo.toml",
        "//libs/rust/content_digest:Cargo.toml",
        "//libs/rust/data_stream:Cargo.toml",
        "//libs/rust/faults:Cargo.toml",
        "//libs/rust/gpu_host:Cargo.toml",
        "//libs/rust/identifiers:Cargo.toml",
        "//libs/rust/ipc:Cargo.toml",
        "//libs/rust/ipc_os:Cargo.toml",
        "//libs/rust/manifests:Cargo.toml",
        "//libs/rust/object_store:Cargo.toml",
        "//libs/rust/process_os:Cargo.toml",
        "//libs/rust/python_bridge:Cargo.toml",
        "//libs/rust/record_io:Cargo.toml",
        "//libs/rust/runtime_core:Cargo.toml",
        "//libs/rust/sandbox_os:Cargo.toml",
        "//libs/rust/servicekit:Cargo.toml",
        "//libs/rust/telemetry:Cargo.toml",
        "//libs/rust/telemetry_spool:Cargo.toml",
        "//libs/rust/tokenizer_runtime:Cargo.toml",
        "//libs/rust/worker_protocol:Cargo.toml",
        "//libs/rust/worker_runtime:Cargo.toml",
        "//serving/runtime:Cargo.toml",
        "//services/artifact_proxy:Cargo.toml",
        "//services/ai_gateway_proxy:Cargo.toml",
        "//services/node_agent:Cargo.toml",
        "//services/runtime_gateway:Cargo.toml",
        "//services/runtime_host:Cargo.toml",
        "//services/workers/ingestion:Cargo.toml",
        "//protocols/rust:Cargo.toml",
        "//tools/qualification/rust/perf_probe:Cargo.toml",
    ],
)
use_repo(crate, "crates")

# Go third-party dependencies are derived from the canonical root go.mod, the
# same way Rust's are derived from Cargo.lock above.
#
# Without this extension the `@cloud_google_com_go_storage`-style labels that
# every Go BUILD file already carries resolve to nothing, so no Go target in
# the repository can be built -- including the `bazel test //libs/go/...` that
# both libs/go/README.md and tools/qualification/go/validate.sh call
# qualification. That gap was invisible because `go test` was doing the work
# and nothing ever asked Bazel.
#
# use_repo lists exactly the modules the BUILD files reference. Adding a new
# external Go dependency to a BUILD file means adding it here too;
# `bazel mod tidy` maintains the list.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_connectrpc_connect",
    "com_connectrpc_grpchealth",
    "com_connectrpc_grpcreflect",
    "com_connectrpc_otelconnect",
    "com_github_googleapis_gax_go_v2",
    "com_github_lib_pq",
    "com_github_prometheus_client_golang",
    "com_github_redis_go_redis_v9",
    "com_google_cloud_go_storage",
    "io_k8s_api",
    "io_k8s_apimachinery",
    "io_k8s_client_go",
    "io_k8s_sigs_controller_runtime",
    "io_opentelemetry_go_contrib_instrumentation_google_golang_org_grpc_otelgrpc",
    "io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp",
    "org_golang_google_api",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_golang_x_oauth2",
)

# Bazel compiles Go with the SAME version go.mod pins. This was previously impossible and the
# note here said so: rules_go 0.51 hardcodes GOEXPERIMENT=nocoverageredesign, Go 1.26 removed
# that experiment, and the toolchain rejects it with "unknown GOEXPERIMENT coverageredesign"
# during GoStdlib. The old note concluded that "every rules_go release in the registry" was
# affected, having verified 0.51 and 0.55 -- but the registry now serves up to 0.63.0, and the
# hardcoded experiment is gone by then.
#
# Verified rather than assumed: the produced binary reports `go1.26.6`, and 216 targets across
# //libs/go, //control, //examples and //services/go_vanity build clean. That also closed
# libs/go/httpx/middleware, which used the Go 1.23 net/http Request.Pattern field and was the
# one target that built with `go build` and not with Bazel.
#
# Keep this compiler on the latest security patch for the language level in go.mod. The go
# directive intentionally expresses the 1.26 language floor; this pin determines the patched
# standard library used by Bazel and must agree with CI and the Nix toolchain evidence.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.6")

# ---------------------------------------------------------------------------------------
# Python interpreter and third-party wheels
# ---------------------------------------------------------------------------------------
# A hermetic interpreter, pinned to the version reusable-uv-ci runs. Without this rules_python
# falls back to whatever `python3` the machine has, which is enough to assemble a py_library
# but not to run a py_test the same way twice.
#
# Keep in step with `requires-python` in pyproject.toml and `python-version` in
# .github/workflows/presubmit.yml.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")

# rules_python 1.7's built-in `3.14` mapping stops at 3.14.0. CI and the Nix closure carry
# 3.14.7, so register the upstream standalone release explicitly and bind the minor selector
# to that exact patch. These are the only host/target platforms the repository declares.
python.single_version_override(
    python_version = "3.14.7",
    sha256 = {
        "aarch64-apple-darwin": "abbf6e8530a283ed795fa91fd6bcf4501e2b1fa287b2cb1c15b70d3028f3a7c9",
        "aarch64-unknown-linux-gnu": "f278d66c15e81f6c77719892e3eb32ff4bca5fc4ab424e171d14bc12bb88b4ee",
        "x86_64-unknown-linux-gnu": "a3a4e4b81b138960c7c546694df8a77578c0b6aa46d47e96f49b9e10e8f860c9",
    },
    urls = [
        "https://github.com/astral-sh/python-build-standalone/releases/download/20260805/cpython-{python_version}+20260805-{platform}-install_only_stripped.tar.gz",
    ],
)
python.override(
    minor_mapping = {"3.14": "3.14.7"},
)
python.toolchain(
    is_default = True,
    python_version = "3.14",
)

# Third-party wheels, resolved from the same project input as the uv lock used by `uv sync`
# and the Python CI lane. The platform locks are generated, never hand-edited:
#
#     uv pip compile pyproject.toml --group dev --generate-hashes --python-version 3.14 \
#       --python-platform linux --only-binary :all: \
#       --output-file requirements.lock.txt
#     MACOSX_DEPLOYMENT_TARGET=14.0 uv pip compile pyproject.toml --group dev \
#       --generate-hashes --python-version 3.14 \
#       --python-platform aarch64-apple-darwin --only-binary :all: \
#       --output-file requirements.darwin.lock.txt
#
# PyTorch publishes `2.13.0` metadata on macOS and `2.13.0+cpu` on its Linux CPU index.
# rules_python merges duplicate normalized names in a universal requirements export, which can
# pair the Linux wheel with the macOS hashes. Separate OS locks keep that choice unambiguous.
# The Darwin lock is arm64-only because x86_64-darwin is explicitly outside the Nix-supported
# system set; Torch 2.13 requires macOS 14. The locks intentionally contain no global extra-index
# option. The Bazel downloader sends only Torch to the CPU index, preventing that index's mirrored
# copies of transitive packages from competing with PyPI artifacts. Every selected distribution
# remains version-pinned and hash-locked, and pip-audit checks the Linux lock independently.
# rules_python cannot read uv.lock, so these compiled locks are the platform-specific bridge.
#
# Wheels are fetched per package and on demand: depending on @pypi//pytest does not download
# torch. That matters here, because torch is the largest dependency in the tree by two orders
# of magnitude and almost nothing needs it at build time.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    download_only = True,
    # Resolve exact wheel URLs from lock-authoritative simple indexes and let Bazel's downloader
    # verify their uv-exported hashes. The package-specific Torch route avoids dependency
    # confusion, keeps foreign platform forks away from host pip during unconfigured graph
    # queries, and prevents accidental source builds.
    experimental_index_url = "https://pypi.org/simple",
    experimental_index_url_overrides = {
        "torch": "https://download.pytorch.org/whl/cpu",
    },
    # Bazel's unconfigured graph queries traverse every marker fork. Tell rules_python which
    # production and development targets those forks represent so repository resolution remains
    # target-aware instead of asking host pip to resolve a foreign Torch requirement.
    experimental_target_platforms = [
        "linux_aarch64",
        "linux_x86_64",
        "osx_aarch64",
    ],
    hub_name = "pypi",
    python_version = "3.14",
    requirements_by_platform = {
        "//:requirements.darwin.lock.txt": "osx_aarch64",
        "//:requirements.lock.txt": "linux_*",
    },
)
pip.parse(
    download_only = True,
    # requirements_by_platform selects the Bazel target platform but does not pass wheel tags
    # to pip. Unlike uv, pip does not expand an explicit manylinux platform to older compatible
    # tags, so spell out packaging.tags' complete glibc 2.28 compatibility set. The MLflow
    # image is pinned to Debian Bookworm (glibc 2.36), and 2.28 is the oldest supported tag
    # that admits the patched Pillow release. Do not pin an ABI: CPython 3.14 must also admit
    # compatible abi3 and pure-Python wheels.
    extra_pip_args = [
        # Bazel materializes independent wheel repositories concurrently. Fresh runners can
        # otherwise exhaust PyPI's 15-second default while downloading the 100+ package MLflow
        # graph, misreporting transport timeouts as "No matching distribution" failures.
        "--timeout=60",
        "--retries=8",
        "--platform=manylinux_2_28_x86_64",
        "--platform=manylinux_2_27_x86_64",
        "--platform=manylinux_2_26_x86_64",
        "--platform=manylinux_2_25_x86_64",
        "--platform=manylinux_2_24_x86_64",
        "--platform=manylinux_2_23_x86_64",
        "--platform=manylinux_2_22_x86_64",
        "--platform=manylinux_2_21_x86_64",
        "--platform=manylinux_2_20_x86_64",
        "--platform=manylinux_2_19_x86_64",
        "--platform=manylinux_2_18_x86_64",
        "--platform=manylinux_2_17_x86_64",
        "--platform=manylinux2014_x86_64",
        "--platform=manylinux_2_16_x86_64",
        "--platform=manylinux_2_15_x86_64",
        "--platform=manylinux_2_14_x86_64",
        "--platform=manylinux_2_13_x86_64",
        "--platform=manylinux_2_12_x86_64",
        "--platform=manylinux2010_x86_64",
        "--platform=manylinux_2_11_x86_64",
        "--platform=manylinux_2_10_x86_64",
        "--platform=manylinux_2_9_x86_64",
        "--platform=manylinux_2_8_x86_64",
        "--platform=manylinux_2_7_x86_64",
        "--platform=manylinux_2_6_x86_64",
        "--platform=manylinux_2_5_x86_64",
        "--platform=manylinux1_x86_64",
        "--python-version=314",
        "--implementation=cp",
    ],
    hub_name = "mlflow_pypi",
    python_version = "3.14",
    requirements_by_platform = {
        "//services/mlflow:requirements.lock.txt": "linux_x86_64",
    },
)
use_repo(pip, "mlflow_pypi", "pypi")

# ---------------------------------------------------------------------------------------
# Container base images
# ---------------------------------------------------------------------------------------
# distroless static, pinned to the SAME digest services/go_vanity used while it was still a
# Dockerfile, so the migration to Bazel OCI changed the build system and not the base bytes.
#
# `nonroot` is uid 65532, which has to agree with runAsUser in
# infra/kubernetes/planes/dev/base/go-vanity.yaml -- a manifest asking for a uid the image does
# not have starts a container that cannot read its own filesystem.
#
# linux/amd64 only. The clusters are amd64 node pools; pulling other platforms costs fetch time
# for a manifest nothing pulls, matching the `platforms` choice in .github/workflows/release.yml.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static",
    digest = "sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a",
    image = "gcr.io/distroless/static-debian12",
    platforms = ["linux/amd64"],
)
oci.pull(
    name = "python_slim",
    digest = "sha256:23c59390fc717bf09f9336908199a0ae75d9c4264bf296123f94ad772fea3b52",
    image = "docker.io/library/python",
    platforms = ["linux/amd64"],
)
oci.pull(
    name = "buildfarm_server",
    digest = "sha256:54567fa9a4d2fc374e200e57e537ba47ce969ec2dcb1e6fd35a25dc8f8a50949",
    image = "docker.io/bazelbuild/buildfarm-server",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
oci.pull(
    name = "buildfarm_worker",
    digest = "sha256:7a10e8f37daecf2e8485acf872e00b02ec6fb7519fe4b6fc32e71ce2b033747d",
    image = "docker.io/bazelbuild/buildfarm-worker",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
use_repo(
    oci,
    "buildfarm_server",
    "buildfarm_server_linux_amd64",
    "buildfarm_server_linux_arm64",
    "buildfarm_worker",
    "buildfarm_worker_linux_amd64",
    "buildfarm_worker_linux_arm64",
    "distroless_static",
    "distroless_static_linux_amd64",
    "python_slim",
    "python_slim_linux_amd64",
)
