#
# Review routing for the monorepo. Ordered by GitHub's rule: the LAST matching pattern wins,
# so the broad default sits at the top and the narrow security paths at the bottom.
#
# Teams here mirror the language law in REPOSITORY_STATUS.md — Go owns the control plane,
# Rust the runtime data plane, Python the science — because that is also how the teams are
# split. Where a directory crosses that line, both teams are listed.
#
# Not routed here: dual-use and screening review. The biosecurity team is `privacy: secret`
# in catalog/teams.yaml and attests on the biosecurity-review attestor rather than through
# pull-request review; naming it in a file every reader of this repo can see would publish
# the membership list that setting exists to keep private. The screening paths below carry
# security + research so the code still gets a second pair of eyes in the PR.

# Everyone, by default.
*                                   @mindclade/engineering

# ---------------------------------------------------------------------------------------
# Go — fleet control plane and durable policy
# ---------------------------------------------------------------------------------------
/control/                           @mindclade/platform
/libs/go/                           @mindclade/platform
/services/                          @mindclade/platform
/services/workers/training/         @mindclade/platform @mindclade/research

# ---------------------------------------------------------------------------------------
# Rust — online/runtime data plane and node execution
# ---------------------------------------------------------------------------------------
/libs/rust/                         @mindclade/platform
/serving/                           @mindclade/platform

# ---------------------------------------------------------------------------------------
# Python — scientific, model, training, inference, and evaluation numerics
# ---------------------------------------------------------------------------------------
/models/                            @mindclade/research
/models/adapters/export/            @mindclade/research @mindclade/security
/training/                          @mindclade/research
/evaluation/                        @mindclade/research
/research/                          @mindclade/research
/kernels/                           @mindclade/research

/data/                              @mindclade/data-platform
/preprocessing/                     @mindclade/data-platform @mindclade/research

# ---------------------------------------------------------------------------------------
# Cross-cutting
# ---------------------------------------------------------------------------------------
# Wire contracts between the three languages. A change here is a change to every runtime at
# once, which is why it is platform-owned rather than owned by whichever language noticed.
/protocols/                         @mindclade/platform
/configs/                           @mindclade/platform
/infra/                             @mindclade/platform
/infra/terraform/                   @mindclade/platform @mindclade/security
/tools/                             @mindclade/platform
/ci/                                @mindclade/platform @mindclade/security
/tools/qualification/training_gke/  @mindclade/platform @mindclade/research @mindclade/security
/architecture/                      @mindclade/platform

# Bazel graph and dependency policy. Root files need explicit routes because the directory
# patterns above cannot match them; lock and rc changes also affect the supply-chain gate.
/BUILD.bazel                        @mindclade/platform
/.bazelrc                           @mindclade/platform @mindclade/security
/.bazelversion                      @mindclade/platform
/.buildifier.json                   @mindclade/platform
/flake.lock                         @mindclade/platform @mindclade/security
/flake.nix                          @mindclade/platform @mindclade/security
/MODULE.bazel                       @mindclade/platform @mindclade/security
/MODULE.bazel.lock                  @mindclade/platform @mindclade/security
/docs/architecture/build-and-toolchains.md @mindclade/platform
/docs/architecture/dependency-rules.md      @mindclade/platform
/tools/dev/bazel-repo-bin/         @mindclade/platform
/tools/dev/bazelw                  @mindclade/platform

# Release evidence. These files are the record that a component was allowed to ship.
/qualification/                     @mindclade/platform @mindclade/security
/qualification/scientific_model_intake/ @mindclade/platform @mindclade/research @mindclade/security
/QUALIFICATION.md                   @mindclade/platform @mindclade/security
/VALIDATION.md                      @mindclade/platform @mindclade/security
/components.toml                    @mindclade/platform @mindclade/security
/maturity.toml                      @mindclade/platform @mindclade/security

# ---------------------------------------------------------------------------------------
# Security — last, so these win over any broader pattern above
# ---------------------------------------------------------------------------------------
/security/                          @mindclade/security
/ci/security/                       @mindclade/security
/deny.toml                          @mindclade/security
/SECURITY.md                        @mindclade/security

# The pipeline that gates everything else, and the ownership map itself.
/.github/                           @mindclade/platform @mindclade/security

# Screening and dual-use surfaces. See the note at the top about biosecurity attestation.
/data/curation/safety_screening.py  @mindclade/security @mindclade/research
/evaluation/biological_risk/        @mindclade/security @mindclade/research
/serving/safety/                    @mindclade/security @mindclade/research
/services/ai_gateway_proxy/        @mindclade/platform @mindclade/security
/services/mlflow/                  @mindclade/platform @mindclade/security
