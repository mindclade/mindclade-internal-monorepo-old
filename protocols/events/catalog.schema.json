{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/events/catalog-v1.json",
  "title": "Mindclade event catalog",
  "type": "object",
  "required": ["schema_version", "authority", "default_content_type", "events"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "authority": { "type": "string", "minLength": 1, "maxLength": 256 },
    "default_content_type": { "type": "string", "const": "application/json" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "channel",
          "topic",
          "message",
          "title",
          "summary",
          "schema",
          "schema_version",
          "content_type",
          "producer",
          "partition_key",
          "delivery",
          "ordering",
          "compatibility",
          "sensitive_fields"
        ],
        "properties": {
          "channel": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{2,127}$", "maxLength": 128 },
          "topic": { "type": "string", "pattern": "^[a-z][a-z0-9.]{2,127}\\.v[1-9][0-9]*$", "maxLength": 160 },
          "message": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{2,127}$", "maxLength": 128 },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
          "schema": { "type": "string", "pattern": "^schemas/[a-z0-9/-]+\\.schema\\.json$", "maxLength": 256 },
          "schema_version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "content_type": { "type": "string", "const": "application/json" },
          "producer": { "type": "string", "minLength": 1, "maxLength": 256 },
          "partition_key": { "type": "string", "const": "workspace" },
          "delivery": { "type": "string", "const": "at_least_once" },
          "ordering": { "type": "string", "const": "per_partition" },
          "compatibility": { "type": "string", "const": "additive_only" },
          "sensitive_fields": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "maxLength": 64 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
