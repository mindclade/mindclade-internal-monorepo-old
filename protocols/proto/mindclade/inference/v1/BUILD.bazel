load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "model_proto",
    srcs = ["model.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = ["//protocols/proto/mindclade/common/v1:identifiers_proto"],
)

proto_library(
    name = "request_proto",
    srcs = ["request.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        ":model_proto",
        "//protocols/proto/mindclade/common/v1:identifiers_proto",
    ],
)

proto_library(
    name = "response_proto",
    srcs = ["response.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        "//protocols/proto/mindclade/artifact/v1:artifact_proto",
        "//protocols/proto/mindclade/common/v1:identifiers_proto",
    ],
)

proto_library(
    name = "stream_proto",
    srcs = ["stream.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        ":response_proto",
        "//protocols/proto/mindclade/common/v1:errors_proto",
    ],
)

proto_library(
    name = "inference_service_proto",
    srcs = ["service.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        ":request_proto",
        ":response_proto",
        ":stream_proto",
    ],
)

# serving/ is Python and speaks this contract end to end, including the stream
# frames that carry common/v1 ErrorDetail and the responses that carry
# artifact/v1 references. The aspect pulls those closures in transitively, but
# only for the proto_library targets named here, so the whole package is listed
# rather than the subset a current caller happens to touch.
py_proto_library(
    name = "inference_py_pb2",
    deps = [
        ":inference_service_proto",
        ":model_proto",
        ":request_proto",
        ":response_proto",
        ":stream_proto",
    ],
)

go_proto_library(
    name = "inference_go_proto",
    compilers = [
        "@rules_go//proto:go_grpc_v2",
        "@rules_go//proto:go_proto",
    ],
    importpath = "go.mindclade.dev/protocols/gen/go/mindclade/inference/v1",
    protos = [
        ":inference_service_proto",
        ":model_proto",
        ":request_proto",
        ":response_proto",
        ":stream_proto",
    ],
    deps = [
        "//protocols/proto/mindclade/artifact/v1:artifact_go_proto",
        "//protocols/proto/mindclade/common/v1:common_go_proto",
    ],
)
