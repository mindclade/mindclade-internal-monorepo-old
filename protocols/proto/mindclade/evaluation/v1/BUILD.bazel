load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "evaluation_proto",
    srcs = ["evaluation.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        "//protocols/proto/mindclade/common/v1:identifiers_proto",
        "@protobuf//:timestamp_proto",
    ],
)

proto_library(
    name = "evaluation_service_proto",
    srcs = ["service.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        ":evaluation_proto",
        "//protocols/proto/mindclade/common/v1:identifiers_proto",
        "//protocols/proto/mindclade/common/v1:pagination_proto",
    ],
)

filegroup(
    name = "scaffold_files",
    srcs = glob(
        ["*.proto"],
        exclude = [
            "evaluation.proto",
            "service.proto",
        ],
    ),
    visibility = ["//visibility:public"],
)
