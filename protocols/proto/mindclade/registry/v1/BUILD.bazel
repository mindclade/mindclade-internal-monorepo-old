load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "reference_database_proto",
    srcs = ["reference_database.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = ["//protocols/proto/mindclade/common/v1:artifact_ref_proto"],
)

proto_library(
    name = "model_bundle_proto",
    srcs = ["model_bundle.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        "//protocols/proto/mindclade/common/v1:identifiers_proto",
        "@protobuf//:timestamp_proto",
    ],
)

proto_library(
    name = "model_service_proto",
    srcs = ["service.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        ":model_bundle_proto",
        "//protocols/proto/mindclade/common/v1:identifiers_proto",
        "//protocols/proto/mindclade/common/v1:pagination_proto",
    ],
)

proto_library(
    name = "release_proto",
    srcs = ["release.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = ["//protocols/proto/mindclade/common/v1:artifact_ref_proto"],
)

proto_library(
    name = "checkpoint_record_proto",
    srcs = ["checkpoint.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        "//protocols/proto/mindclade/common/v1:artifact_ref_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library(
    name = "checkpoint_record_py_pb2",
    deps = [":checkpoint_record_proto"],
)

filegroup(
    name = "cargo_checkpoint_proto_sources",
    srcs = ["checkpoint.proto"],
    visibility = ["//protocols/rust:__pkg__"],
)

py_proto_library(
    name = "release_py_pb2",
    deps = [":release_proto"],
)

go_proto_library(
    name = "registry_go_proto",
    compilers = [
        "@rules_go//proto:go_grpc_v2",
        "@rules_go//proto:go_proto",
    ],
    importpath = "go.mindclade.dev/protocols/gen/go/mindclade/registry/v1",
    protos = [
        ":checkpoint_record_proto",
        ":model_bundle_proto",
        ":model_service_proto",
        ":reference_database_proto",
        ":release_proto",
    ],
    deps = ["//protocols/proto/mindclade/common/v1:common_go_proto"],
)
