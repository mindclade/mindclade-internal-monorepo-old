load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "envelope_proto",
    srcs = ["envelope.proto"],
    strip_import_prefix = "/protocols/proto",
)

proto_library(
    name = "admission_events_proto",
    srcs = ["admission_events.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = ["@protobuf//:timestamp_proto"],
)

# Python workers emit admission and lifecycle events into the same envelope the
# Go control plane reads. An envelope re-declared on the Python side is a silent
# wire fork that no compatibility test can see.
py_proto_library(
    name = "events_py_pb2",
    deps = [
        ":admission_events_proto",
        ":envelope_proto",
    ],
)

go_proto_library(
    name = "events_go_proto",
    importpath = "go.mindclade.dev/protocols/gen/go/mindclade/events/v1",
    protos = [
        ":admission_events_proto",
        ":envelope_proto",
    ],
)
