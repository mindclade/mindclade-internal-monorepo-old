load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "stage_proto",
    srcs = ["stage.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        "//protocols/proto/mindclade/common/v1:artifact_ref_proto",
        "//protocols/proto/mindclade/runtime/v1:execution_budget_proto",
    ],
)

proto_library(
    name = "run_proto",
    srcs = ["run.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        "//protocols/proto/mindclade/common/v1:errors_proto",
        "//protocols/proto/mindclade/common/v1:identifiers_proto",
        "@protobuf//:timestamp_proto",
    ],
)

proto_library(
    name = "run_service_proto",
    srcs = ["service.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        ":run_proto",
        "//protocols/proto/mindclade/common/v1:identifiers_proto",
        "//protocols/proto/mindclade/common/v1:pagination_proto",
    ],
)

proto_library(
    name = "workflow_proto",
    srcs = ["workflow.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        ":stage_proto",
        "//protocols/proto/mindclade/common/v1:identifiers_proto",
    ],
)

proto_library(
    name = "workload_proto",
    srcs = ["workload.proto"],
    strip_import_prefix = "/protocols/proto",
    deps = [
        ":stage_proto",
        "//protocols/proto/mindclade/common/v1:artifact_ref_proto",
        "//protocols/proto/mindclade/runtime/v1:execution_ticket_proto",
    ],
)

# Python training, preprocessing, and evaluation entry points are launched as
# orchestration workloads and report run state back on this contract, so the
# stage, workload, and run shapes have to be generated rather than reconstructed
# from the Go definitions.
py_proto_library(
    name = "orchestration_py_pb2",
    deps = [
        ":run_proto",
        ":run_service_proto",
        ":stage_proto",
        ":workflow_proto",
        ":workload_proto",
    ],
)

go_proto_library(
    name = "orchestration_go_proto",
    compilers = [
        "@rules_go//proto:go_grpc_v2",
        "@rules_go//proto:go_proto",
    ],
    importpath = "go.mindclade.dev/protocols/gen/go/mindclade/orchestration/v1",
    protos = [
        ":run_proto",
        ":run_service_proto",
        ":stage_proto",
        ":workflow_proto",
        ":workload_proto",
    ],
    deps = [
        "//protocols/proto/mindclade/common/v1:common_go_proto",
        "//protocols/proto/mindclade/runtime/v1:runtime_go_proto",
    ],
)
