genrule(
    name = "protobuf_descriptor_set",
    srcs = [
        ":all_proto_sources",
        "@protobuf//:well_known_type_protos",
    ],
    outs = ["mindclade-protobuf-descriptor-set.proto.bin"],
    cmd = "$(execpath @protobuf//:protoc) " +
          "--proto_path=protocols/proto " +
          "--proto_path=external/protobuf+/src " +
          "--include_imports " +
          "--descriptor_set_out=$@ " +
          "$(locations :all_proto_sources)",
    tools = ["@protobuf//:protoc"],
)

# Immutable, data-only OCI contract bundle. The descriptor, canonical sources,
# compatibility baseline, and machine-readable maturity declaration travel as
# one digest-addressed release subject; consumers never depend on a mutable tag
# or on a separately regenerated descriptor.
pkg_tar(
    name = "protobuf_contract_layer",
    srcs = [
        "buf.yaml",
        "compatibility/breaking-policy.yaml",
        "compatibility/protobuf-surfaces.json",
        "compatibility/protobuf-v1-descriptor.json",
        ":all_proto_sources",
        ":protobuf_descriptor_set",
    ],
    mode = "0444",
    package_dir = "/contracts",
)

oci_image(
    name = "protobuf_contract_image",
    architecture = "amd64",
    os = "linux",
    tars = [":protobuf_contract_layer"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "protobuf_contract_push",
    image = ":protobuf_contract_image",
    repository = "localhost/mindclade/protobuf-contracts",
    visibility = ["//visibility:public"],
)

py_test(
    name = "protobuf_governance_test",
    srcs = ["compatibility/descriptor_contract.py"],
    data = [
        "compatibility/protobuf-surfaces.json",
        "compatibility/protobuf-v1-descriptor.json",
        ":all_proto_sources",
        ":protobuf_descriptor_set",
    ],
    main = "compatibility/descriptor_contract.py",
    deps = ["//protocols/proto/mindclade/artifact/v1:checkpoint_commit_py_pb2"],
)

py_test(
    name = "typescript_projection_test",
    srcs = ["compatibility/check_typescript_projection.py"],
    data = [
        "compatibility/scaffold-removal-waiver.json",
        ":all_proto_sources",
        "//sdk/typescript:generated_protobuf_sources",
    ],
    main = "compatibility/check_typescript_projection.py",
)
