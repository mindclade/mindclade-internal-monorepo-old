    name = "all_proto_sources",
    srcs = [
        "//protocols/proto/mindclade/artifact/v1:artifact.proto",
        "//protocols/proto/mindclade/artifact/v1:checkpoint.proto",
        "//protocols/proto/mindclade/artifact/v1:manifest.proto",
        "//protocols/proto/mindclade/artifact/v1:service.proto",
        "//protocols/proto/mindclade/common/v1:artifact_ref.proto",
        "//protocols/proto/mindclade/common/v1:errors.proto",
        "//protocols/proto/mindclade/common/v1:identifiers.proto",
        "//protocols/proto/mindclade/common/v1:pagination.proto",
        "//protocols/proto/mindclade/data/v1:cursor.proto",
        "//protocols/proto/mindclade/data/v1:dataset.proto",
        "//protocols/proto/mindclade/data/v1:record.proto",
        "//protocols/proto/mindclade/data/v1:service.proto",
        "//protocols/proto/mindclade/data/v1:shard.proto",
        "//protocols/proto/mindclade/data/v1:snapshot.proto",
        "//protocols/proto/mindclade/data/v1:source.proto",
        "//protocols/proto/mindclade/evaluation/v1:evaluation.proto",
        "//protocols/proto/mindclade/evaluation/v1:service.proto",
        "//protocols/proto/mindclade/events/v1:admission_events.proto",
        "//protocols/proto/mindclade/events/v1:envelope.proto",
        "//protocols/proto/mindclade/inference/v1:model.proto",
        "//protocols/proto/mindclade/inference/v1:request.proto",
        "//protocols/proto/mindclade/inference/v1:response.proto",
        "//protocols/proto/mindclade/inference/v1:service.proto",
        "//protocols/proto/mindclade/inference/v1:stream.proto",
        "//protocols/proto/mindclade/orchestration/v1:run.proto",
        "//protocols/proto/mindclade/orchestration/v1:service.proto",
        "//protocols/proto/mindclade/orchestration/v1:stage.proto",
        "//protocols/proto/mindclade/orchestration/v1:workflow.proto",
        "//protocols/proto/mindclade/orchestration/v1:workload.proto",
        "//protocols/proto/mindclade/registry/v1:checkpoint.proto",
        "//protocols/proto/mindclade/registry/v1:model_bundle.proto",
        "//protocols/proto/mindclade/registry/v1:reference_database.proto",
        "//protocols/proto/mindclade/registry/v1:release.proto",
        "//protocols/proto/mindclade/registry/v1:service.proto",
        "//protocols/proto/mindclade/runtime/v1:artifact_grant.proto",
        "//protocols/proto/mindclade/runtime/v1:buffer_descriptor.proto",
