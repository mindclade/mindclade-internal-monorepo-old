load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//libs/rust:repo_consumers"])

rust_library(
    name = "mindclade_protocols",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mindclade_protocols",
    edition = "2024",
    deps = [
        ":build_script",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:tonic",
        "@crates//:tonic-prost",
    ],
)

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "PROTOBUF_WELL_KNOWN_PROTOS": "$(execpaths @protobuf//:well_known_type_protos)",
        "PROTOC": "$(execpath @protobuf//:protoc)",
    },
    crate_root = "build.rs",
    data = [
        "//protocols/proto/mindclade/artifact/v1:cargo_checkpoint_proto_sources",
        "//protocols/proto/mindclade/common/v1:cargo_checkpoint_proto_sources",
        "//protocols/proto/mindclade/registry/v1:cargo_checkpoint_proto_sources",
        "//protocols/proto/mindclade/runtime/v1:cargo_proto_sources",
        "//protocols/proto/mindclade/training/v1:cargo_checkpoint_proto_sources",
        "@protobuf//:well_known_type_protos",
    ],
    edition = "2024",
    tools = ["@protobuf//:protoc"],
    deps = [
        "@crates//:protoc-bin-vendored",
        "@crates//:tonic-prost-build",
    ],
)

rust_test(
    name = "runtime_roundtrip",
    srcs = ["tests/runtime_roundtrip.rs"],
    edition = "2024",
    deps = [
        ":mindclade_protocols",
        "@crates//:prost",
        "@crates//:tonic",
    ],
)

rust_test(
    name = "inference_roundtrip",
    srcs = ["tests/inference_roundtrip.rs"],
    edition = "2024",
    deps = [
        ":mindclade_protocols",
        "@crates//:prost",
        "@crates//:tonic",
    ],
)

rust_test(
    name = "checkpoint_contract_roundtrip",
    srcs = ["tests/checkpoint_contract_roundtrip.rs"],
    compile_data = ["//tests/integration/cross_language:checkpoint_contract_v1_fixture"],
    edition = "2024",
    deps = [
        ":mindclade_protocols",
        "@crates//:prost",
        "@crates//:serde_json",
    ],
)

filegroup(
    name = "package_sources",
    srcs = glob(
        ["**"],
        exclude = ["target/**"],
    ),
    visibility = ["//libs/rust:repo_consumers"],
)
