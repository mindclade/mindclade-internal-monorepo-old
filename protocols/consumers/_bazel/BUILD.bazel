load("@rules_go//go:def.bzl", "go_test")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//protocols/consumers:__pkg__"])

go_test(
    name = "generated_go_test",
    srcs = ["generated_go_test.go"],
    deps = [
        "//protocols/proto/mindclade/artifact/v1:artifact_go_proto",
        "//protocols/proto/mindclade/common/v1:common_go_proto",
        "//protocols/proto/mindclade/data/v1:data_go_proto",
        "//protocols/proto/mindclade/evaluation/v1:evaluation_go_proto",
        "//protocols/proto/mindclade/events/v1:events_go_proto",
        "//protocols/proto/mindclade/inference/v1:inference_go_proto",
        "//protocols/proto/mindclade/orchestration/v1:orchestration_go_proto",
        "//protocols/proto/mindclade/registry/v1:registry_go_proto",
        "//protocols/proto/mindclade/runtime/v1:runtime_go_proto",
        "//protocols/proto/mindclade/training/v1:training_go_proto",
        "@org_golang_google_protobuf//proto",
    ],
)

# The binding that makes the generated Go bindings load-bearing instead of merely
# linkable. `generated_go_test` above proves the ten packages compile and register
# descriptors; it compares them to nothing. This target compares one hand-written
# production taxonomy — libs/go/faults — against the descriptor protoc built from
# errors.proto, so a drift between them fails a build rather than a peer.
#
# It depends on a `//libs/...` target, which the layer matrix permits: layers.bzl
# places both `//protocols/...` and `//libs/...` in `foundation`, and
# foundation -> foundation is an allowed direction. The dependency only runs in
# this direction; libs/go/faults still imports nothing but the standard library,
# which is what keeps it at Layer 0 in libs/go/LAYERS.md.
go_test(
    name = "faults_conformance_test",
    srcs = ["faults_conformance_test.go"],
    deps = [
        "//libs/go/faults",
        "//protocols/proto/mindclade/common/v1:common_go_proto",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)

# The Python half of the same conformance claim. protoc emits one module per `.proto`
# rather than one package per proto package, so this target has to name every
# `py_proto_library` in the repository: the test asserts the generated Python surface is
# the whole promoted set, and a `py_proto_library` nobody depends on is a target that is
# built but never imported. `all_proto_sources` is the enumeration the test partitions
# against — without it the coverage assertion has nothing to compare the generated
# modules to and would pass on an empty tree.
pytest_test(
    name = "generated_python_test",
    srcs = ["generated_python_test.py"],
    data = ["//protocols:all_proto_sources"],
    deps = [
        "//protocols/proto/mindclade/artifact/v1:checkpoint_commit_py_pb2",
        "//protocols/proto/mindclade/common/v1:common_py_pb2",
        "//protocols/proto/mindclade/data/v1:data_py_pb2",
        "//protocols/proto/mindclade/evaluation/v1:evaluation_py_pb2",
        "//protocols/proto/mindclade/events/v1:events_py_pb2",
        "//protocols/proto/mindclade/inference/v1:inference_py_pb2",
        "//protocols/proto/mindclade/orchestration/v1:orchestration_py_pb2",
        "//protocols/proto/mindclade/registry/v1:checkpoint_record_py_pb2",
        "//protocols/proto/mindclade/registry/v1:release_py_pb2",
        "//protocols/proto/mindclade/runtime/v1:runtime_worker_py_pb2",
        "//protocols/proto/mindclade/training/v1:checkpoint_contract_py_pb2",
    ],
)

go_test(
    name = "_bazel_test",
    srcs = ["generated_go_test.go"],
    deps = [
        "//protocols/proto/mindclade/artifact/v1:artifact_go_proto",
        "//protocols/proto/mindclade/common/v1:common_go_proto",
        "//protocols/proto/mindclade/data/v1:data_go_proto",
        "//protocols/proto/mindclade/evaluation/v1:evaluation_go_proto",
        "//protocols/proto/mindclade/events/v1:events_go_proto",
        "//protocols/proto/mindclade/inference/v1:inference_go_proto",
        "//protocols/proto/mindclade/orchestration/v1:orchestration_go_proto",
        "//protocols/proto/mindclade/registry/v1:registry_go_proto",
        "//protocols/proto/mindclade/runtime/v1:runtime_go_proto",
        "//protocols/proto/mindclade/training/v1:training_go_proto",
        "@org_golang_google_protobuf//proto",
    ],
)
