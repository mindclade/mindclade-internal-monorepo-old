{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.com/contracts/config/run-1.0.0.schema.json",
  "title": "Mindclade reproducible run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "kind", "owner", "sourceRevision", "resolvedConfigDigest", "toolchainDigest", "inputDigests", "seed", "environmentProfile", "hardwareProfile", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "mindclade.dev/run/v1"},
    "runId": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["evaluation", "inference", "ingestion", "preprocessing", "training"]},
    "owner": {"$ref": "#/$defs/id"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "resolvedConfigDigest": {"$ref": "#/$defs/digest"},
    "toolchainDigest": {"$ref": "#/$defs/digest"},
    "inputDigests": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "seed": {"type": "integer", "minimum": 0},
    "environmentProfile": {"$ref": "#/$defs/id"},
    "hardwareProfile": {"$ref": "#/$defs/id"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
