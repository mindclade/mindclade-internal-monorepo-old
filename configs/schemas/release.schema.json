{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.com/contracts/config/release-1.0.0.schema.json",
  "title": "Mindclade release request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "subjectDigest", "sourceRevision", "artifacts", "evidence", "rollback"],
  "properties": {
    "schemaVersion": {"const": "mindclade.dev/release/v1"},
    "releaseId": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9-]+)?$"},
    "subjectDigest": {"$ref": "#/$defs/digest"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/artifact"}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sbom", "provenance", "vulnerability", "qualification"],
      "properties": {
        "sbom": {"$ref": "#/$defs/digest"},
        "provenance": {"$ref": "#/$defs/digest"},
        "vulnerability": {"$ref": "#/$defs/digest"},
        "qualification": {"$ref": "#/$defs/digest"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousReleaseId", "previousSubjectDigest", "procedureDigest"],
      "properties": {
        "previousReleaseId": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9-]+)?$"},
        "previousSubjectDigest": {"$ref": "#/$defs/digest"},
        "procedureDigest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uri", "digest"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "uri": {"type": "string", "pattern": "^(gs|oci)://[^\\s]+$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
