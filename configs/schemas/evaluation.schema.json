{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.com/contracts/config/evaluation-1.0.0.schema.json",
  "title": "Mindclade evaluation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evaluationId", "owner", "candidateDigest", "datasetDigests", "holdoutIsolation", "metrics", "promotionPolicy"],
  "properties": {
    "schemaVersion": {"const": "mindclade.dev/evaluation/v1"},
    "evaluationId": {"$ref": "#/$defs/id"},
    "owner": {"$ref": "#/$defs/id"},
    "candidateDigest": {"$ref": "#/$defs/digest"},
    "datasetDigests": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "holdoutIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "trainerAccess", "resultRedaction"],
      "properties": {
        "enabled": {"const": true},
        "trainerAccess": {"const": "denied"},
        "resultRedaction": {"const": "aggregate-only"}
      }
    },
    "metrics": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/metric"}},
    "promotionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automaticPromotion", "requireIndependentAttestor", "requireSafetyReview"],
      "properties": {
        "automaticPromotion": {"const": false},
        "requireIndependentAttestor": {"const": true},
        "requireSafetyReview": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "threshold", "minimumSamples", "datasetDigest"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
        "direction": {"enum": ["at-least", "at-most"]},
        "threshold": {"type": "number"},
        "minimumSamples": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "datasetDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
