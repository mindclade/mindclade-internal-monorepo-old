load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "contract_validation",
    srcs = ["contract_validation.py"],
    data = glob([
        "schemas/*.json",
        "fixtures/*.json",
    ]),
    imports = [".."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "validate_contracts",
    srcs = ["validate_contracts.py"],
    deps = [":contract_validation"],
)

pytest_test(
    name = "test_contracts",
    srcs = ["tests/test_contracts.py"],
    data = glob([
        "schemas/*.json",
        "fixtures/*.json",
    ]),
    imports = [".."],
    deps = [":contract_validation"],
)

filegroup(
    name = "model_contract_fixtures",
    srcs = [
        "fixtures/model-target-card.valid.json",
        "fixtures/model-target-card-v1.valid.json",
        "fixtures/scientific-model-intake.valid.json",
    ],
    visibility = ["//visibility:public"],
)

# The live-datastore suite contract is data for ci/presubmit/live_datastore_gate.py and its
# tests. Exported as its own filegroup rather than through :scaffold_files so a consumer depends
# on the one policy file it reads.
filegroup(
    name = "live_datastore_suites",
    srcs = ["qualification/live_datastore_suites.toml"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "scaffold_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
